{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperray.dev/schemas/v1/summary.schema.json",
  "title": "Hyperray component summary",
  "description": "This schema validates a component summary shape. Only a proof-certificate checker can establish contextual trace equality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "summary_id",
    "component",
    "boundary",
    "executable_image",
    "model",
    "requirement",
    "semantics",
    "interface",
    "interface_traces",
    "hidden_state_relation",
    "assumptions",
    "interference",
    "reentrancy",
    "callbacks",
    "shared_state",
    "fairness",
    "equivalence",
    "proof_certificate",
    "dependency_hashes"
  ],
  "properties": {
    "artifact_type": { "const": "hyperray_component_summary" },
    "schema_version": { "const": 1 },
    "artifact_id": { "$ref": "#/$defs/identifier" },
    "summary_id": { "$ref": "#/$defs/identifier" },
    "component": { "$ref": "#/$defs/artifactRef" },
    "boundary": { "$ref": "#/$defs/artifactRef" },
    "executable_image": { "$ref": "#/$defs/artifactRef" },
    "model": { "$ref": "#/$defs/artifactRef" },
    "requirement": { "$ref": "#/$defs/artifactRef" },
    "semantics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactRef" } },
    "interface": { "$ref": "#/$defs/interface" },
    "interface_traces": { "$ref": "#/$defs/interfaceTraces" },
    "hidden_state_relation": { "$ref": "#/$defs/hiddenStateRelation" },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "interference": { "$ref": "#/$defs/interference" },
    "reentrancy": { "$ref": "#/$defs/reentrancy" },
    "callbacks": { "$ref": "#/$defs/callbacks" },
    "shared_state": { "$ref": "#/$defs/sharedState" },
    "fairness": { "type": "array", "items": { "$ref": "#/$defs/fairnessClause" } },
    "equivalence": { "$ref": "#/$defs/equivalence" },
    "proof_certificate": { "$ref": "#/$defs/proofCertificate" },
    "dependency_hashes": { "$ref": "#/$defs/dependencyHashes" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "formalPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logic", "expression", "free_variables"],
      "properties": {
        "logic": { "enum": ["propositional.v1", "bitvector.v1", "finite_relation.v1"] },
        "expression": { "type": "string", "minLength": 1 },
        "free_variables": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calling_convention",
        "entry_root_ids",
        "entry_preconditions",
        "exit_ids",
        "external_effect_ids",
        "transition_label_ids",
        "terminal_label_ids",
        "memory_ownership"
      ],
      "properties": {
        "calling_convention": { "type": "string", "minLength": 1 },
        "entry_root_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "entry_preconditions": { "type": "array", "items": { "$ref": "#/$defs/formalPredicate" } },
        "exit_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "external_effect_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "transition_label_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "terminal_label_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "memory_ownership": { "type": "array", "items": { "$ref": "#/$defs/ownershipRule" } }
      }
    },
    "ownershipRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "owner_id", "entry_rule", "exit_rule"],
      "properties": {
        "object_id": { "$ref": "#/$defs/identifier" },
        "owner_id": { "$ref": "#/$defs/identifier" },
        "entry_rule": { "$ref": "#/$defs/formalPredicate" },
        "exit_rule": { "$ref": "#/$defs/formalPredicate" }
      }
    },
    "traceLanguage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "language_artifact", "alphabet_sha256"],
          "properties": {
            "kind": { "const": "finite_trace_automaton.v1" },
            "language_artifact": { "$ref": "#/$defs/artifactRef" },
            "alphabet_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "language_artifact", "acceptance_artifact", "alphabet_sha256"],
          "properties": {
            "kind": { "const": "infinite_buchi_trace_automaton.v1" },
            "language_artifact": { "$ref": "#/$defs/artifactRef" },
            "acceptance_artifact": { "$ref": "#/$defs/artifactRef" },
            "alphabet_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "terminalTraceLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "deadlock", "trap", "abort", "undefined_behavior", "capacity_error", "internal_divergence"],
      "properties": {
        "success": { "$ref": "#/$defs/identifier" },
        "deadlock": { "$ref": "#/$defs/identifier" },
        "trap": { "$ref": "#/$defs/identifier" },
        "abort": { "$ref": "#/$defs/identifier" },
        "undefined_behavior": { "$ref": "#/$defs/identifier" },
        "capacity_error": { "$ref": "#/$defs/identifier" },
        "internal_divergence": { "$ref": "#/$defs/identifier" }
      }
    },
    "interfaceTraces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_alphabet", "observation_function", "finite_maximal_traces", "infinite_traces", "terminal_labels"],
      "properties": {
        "observation_alphabet": { "$ref": "#/$defs/artifactRef" },
        "observation_function": { "$ref": "#/$defs/artifactRef" },
        "finite_maximal_traces": {
          "allOf": [
            { "$ref": "#/$defs/traceLanguage" },
            { "properties": { "kind": { "const": "finite_trace_automaton.v1" } } }
          ]
        },
        "infinite_traces": {
          "allOf": [
            { "$ref": "#/$defs/traceLanguage" },
            { "properties": { "kind": { "const": "infinite_buchi_trace_automaton.v1" } } }
          ]
        },
        "terminal_labels": { "$ref": "#/$defs/terminalTraceLabels" }
      }
    },
    "hiddenStateRelation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "component_state_count", "summary_state_count", "relation_artifact", "totality_proof"],
          "properties": {
            "kind": { "const": "explicit_relation.v1" },
            "component_state_count": { "type": "integer", "minimum": 1 },
            "summary_state_count": { "type": "integer", "minimum": 1 },
            "relation_artifact": { "$ref": "#/$defs/artifactRef" },
            "totality_proof": { "$ref": "#/$defs/artifactRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "encoding_version", "component_state_bits", "summary_state_bits", "relation_circuit", "totality_proof"],
          "properties": {
            "kind": { "const": "sequential_circuit_relation" },
            "encoding_version": { "const": 1 },
            "component_state_bits": { "type": "integer", "minimum": 1 },
            "summary_state_bits": { "type": "integer", "minimum": 1 },
            "relation_circuit": { "$ref": "#/$defs/artifactRef" },
            "totality_proof": { "$ref": "#/$defs/artifactRef" }
          }
        }
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "kind", "predicate", "provenance"],
      "properties": {
        "assumption_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["compatible_context", "root_precondition", "environment", "calling_convention", "memory_ownership", "progress"] },
        "predicate": { "$ref": "#/$defs/formalPredicate" },
        "provenance": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "interferenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "actor_id", "shared_object_ids", "predicate"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/identifier" },
        "actor_id": { "$ref": "#/$defs/identifier" },
        "shared_object_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "predicate": { "$ref": "#/$defs/formalPredicate" }
      }
    },
    "interference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rely_rules", "guarantee_rules", "undeclared_interference_policy"],
      "properties": {
        "rely_rules": { "type": "array", "items": { "$ref": "#/$defs/interferenceRule" } },
        "guarantee_rules": { "type": "array", "items": { "$ref": "#/$defs/interferenceRule" } },
        "undeclared_interference_policy": { "const": "engine_error" }
      }
    },
    "reentrancy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reentry_behavior", "provenance"],
          "properties": {
            "kind": { "const": "forbidden" },
            "reentry_behavior": { "$ref": "#/$defs/formalPredicate" },
            "provenance": { "$ref": "#/$defs/artifactRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "maximum_depth", "reentry_root_ids", "capacity_behavior", "provenance"],
          "properties": {
            "kind": { "const": "finite" },
            "maximum_depth": { "type": "integer", "minimum": 1 },
            "reentry_root_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
            "capacity_behavior": { "$ref": "#/$defs/formalPredicate" },
            "provenance": { "$ref": "#/$defs/artifactRef" }
          }
        }
      ]
    },
    "callbackRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callback_id", "root_id", "entry_assumption_ids", "shared_object_ids", "transition_rule", "provenance"],
      "properties": {
        "callback_id": { "$ref": "#/$defs/identifier" },
        "root_id": { "$ref": "#/$defs/identifier" },
        "entry_assumption_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "shared_object_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "transition_rule": { "$ref": "#/$defs/formalPredicate" },
        "provenance": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "callbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "undeclared_callback_policy"],
      "properties": {
        "allowed": { "type": "array", "items": { "$ref": "#/$defs/callbackRule" } },
        "undeclared_callback_policy": { "const": "engine_error" }
      }
    },
    "sharedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "ownership", "read_actor_ids", "write_actor_ids", "atomicity_rule", "synchronization_rule"],
      "properties": {
        "object_id": { "$ref": "#/$defs/identifier" },
        "ownership": { "enum": ["component", "context", "shared"] },
        "read_actor_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "write_actor_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "atomicity_rule": { "$ref": "#/$defs/formalPredicate" },
        "synchronization_rule": { "$ref": "#/$defs/formalPredicate" }
      }
    },
    "sharedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "undeclared_shared_state_policy"],
      "properties": {
        "objects": { "type": "array", "items": { "$ref": "#/$defs/sharedObject" } },
        "undeclared_shared_state_policy": { "const": "engine_error" }
      }
    },
    "fairnessClause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fairness_id", "kind", "subject_ids", "predicate", "provenance"],
      "properties": {
        "fairness_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["weak", "strong", "justice", "compassion", "none"] },
        "subject_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "predicate": { "$ref": "#/$defs/formalPredicate" },
        "provenance": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "preservedFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finite_maximal_traces", "infinite_traces", "roots", "preconditions", "exits", "effects", "transition_labels", "terminal_labels", "requirement_labels", "acceptance_sets", "fairness", "internal_divergence"],
      "properties": {
        "finite_maximal_traces": { "const": true },
        "infinite_traces": { "const": true },
        "roots": { "const": true },
        "preconditions": { "const": true },
        "exits": { "const": true },
        "effects": { "const": true },
        "transition_labels": { "const": true },
        "terminal_labels": { "const": true },
        "requirement_labels": { "const": true },
        "acceptance_sets": { "const": true },
        "fairness": { "const": true },
        "internal_divergence": { "const": true }
      }
    },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theorem", "compatible_contexts", "applicable_root_ids", "preserved_facts"],
      "properties": {
        "theorem": { "const": "contextual_trace_equality" },
        "compatible_contexts": { "$ref": "#/$defs/artifactRef" },
        "applicable_root_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "preserved_facts": { "$ref": "#/$defs/preservedFacts" }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_sha256", "arguments"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "arguments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "proofCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checker", "certificate", "contextual_trace_equality", "assumption_discharge", "dependency_match"],
      "properties": {
        "status": { "const": "accepted" },
        "checker": { "$ref": "#/$defs/toolIdentity" },
        "certificate": { "$ref": "#/$defs/artifactRef" },
        "contextual_trace_equality": { "const": "accepted" },
        "assumption_discharge": { "const": "accepted" },
        "dependency_match": { "const": "accepted" }
      }
    },
    "dependencyHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "boundary", "executable_image", "model", "requirement", "environment", "semantics", "invalidation_rule"],
      "properties": {
        "component": { "$ref": "#/$defs/artifactRef" },
        "boundary": { "$ref": "#/$defs/artifactRef" },
        "executable_image": { "$ref": "#/$defs/artifactRef" },
        "model": { "$ref": "#/$defs/artifactRef" },
        "requirement": { "$ref": "#/$defs/artifactRef" },
        "environment": { "$ref": "#/$defs/artifactRef" },
        "semantics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactRef" } },
        "invalidation_rule": { "const": "digest_mismatch_invalidates_summary" }
      }
    }
  }
}
