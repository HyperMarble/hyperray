{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperray.dev/schemas/v1/result.schema.json",
  "title": "Hyperray proof result or engine error",
  "description": "This schema validates result shape and separates logic verdicts from engine errors. It does not prove a verdict or replay a witness.",
  "oneOf": [
    { "$ref": "#/$defs/provedResult" },
    { "$ref": "#/$defs/safetyDisprovedResult" },
    { "$ref": "#/$defs/temporalLassoDisprovedResult" },
    { "$ref": "#/$defs/terminationDeadlockDisprovedResult" },
    { "$ref": "#/$defs/engineError" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "claimIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "boundary",
        "model",
        "executable_image",
        "compiler_inventory",
        "semantics",
        "coverage",
        "proof_certificate",
        "trust_assumptions",
        "query_id",
        "selected_root_ids"
      ],
      "properties": {
        "requirement": { "$ref": "#/$defs/artifactRef" },
        "boundary": { "$ref": "#/$defs/artifactRef" },
        "model": { "$ref": "#/$defs/artifactRef" },
        "executable_image": { "$ref": "#/$defs/artifactRef" },
        "compiler_inventory": { "$ref": "#/$defs/artifactRef" },
        "semantics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactRef" } },
        "coverage": { "$ref": "#/$defs/artifactRef" },
        "proof_certificate": { "$ref": "#/$defs/artifactRef" },
        "trust_assumptions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactRef" } },
        "query_id": { "$ref": "#/$defs/identifier" },
        "selected_root_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "safetyProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reachable_state_count", "reachable_transition_count", "fixed_point_iterations", "certificate"],
      "properties": {
        "kind": { "const": "safety_fixed_point" },
        "reachable_state_count": { "type": "integer", "minimum": 0 },
        "reachable_transition_count": { "type": "integer", "minimum": 0 },
        "fixed_point_iterations": { "type": "integer", "minimum": 1 },
        "certificate": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "temporalProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reachable_product_state_count", "cyclic_component_count", "accepting_component_count", "certificate"],
      "properties": {
        "kind": { "const": "temporal_accepting_cycle_absence" },
        "reachable_product_state_count": { "type": "integer", "minimum": 0 },
        "cyclic_component_count": { "type": "integer", "minimum": 0 },
        "accepting_component_count": { "const": 0 },
        "certificate": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "terminationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reachable_state_count", "nonterminal_deadlock_count", "accepting_cycle_count", "certificate"],
      "properties": {
        "kind": { "const": "termination_complete" },
        "reachable_state_count": { "type": "integer", "minimum": 0 },
        "nonterminal_deadlock_count": { "const": 0 },
        "accepting_cycle_count": { "const": 0 },
        "certificate": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "provedProof": {
      "oneOf": [
        { "$ref": "#/$defs/safetyProof" },
        { "$ref": "#/$defs/temporalProof" },
        { "$ref": "#/$defs/terminationProof" }
      ]
    },
    "provedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "verdict", "claim", "proof"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 1 },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "result_id": { "$ref": "#/$defs/identifier" },
        "result_kind": { "const": "PROVED" },
        "verdict": { "const": "PROVED" },
        "claim": { "$ref": "#/$defs/claimIdentity" },
        "proof": { "$ref": "#/$defs/provedProof" }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_ids", "transition_ids"],
      "properties": {
        "state_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "transition_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "violationLocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "state_id"],
          "properties": {
            "kind": { "const": "state" },
            "state_id": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_state_id", "transition_id", "target_state_id"],
          "properties": {
            "kind": { "const": "transition" },
            "source_state_id": { "$ref": "#/$defs/identifier" },
            "transition_id": { "$ref": "#/$defs/identifier" },
            "target_state_id": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "violationCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate_id", "monitor_state_id", "message"],
      "properties": {
        "predicate_id": { "$ref": "#/$defs/identifier" },
        "monitor_state_id": { "$ref": "#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "safetyWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selected_root_id", "path", "applicable_state_id", "violation", "cause", "replay_certificate"],
      "properties": {
        "kind": { "const": "safety" },
        "selected_root_id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/path" },
        "applicable_state_id": { "$ref": "#/$defs/identifier" },
        "violation": { "$ref": "#/$defs/violationLocation" },
        "cause": { "$ref": "#/$defs/violationCause" },
        "replay_certificate": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "temporalLassoWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "selected_root_id",
        "prefix",
        "cycle_state_ids",
        "cycle_transition_ids",
        "applicable_state_id",
        "acceptance_ids",
        "fairness_ids",
        "cause",
        "replay_certificate"
      ],
      "properties": {
        "kind": { "const": "temporal_lasso" },
        "selected_root_id": { "$ref": "#/$defs/identifier" },
        "prefix": { "$ref": "#/$defs/path" },
        "cycle_state_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "cycle_transition_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "applicable_state_id": { "$ref": "#/$defs/identifier" },
        "acceptance_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "fairness_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "cause": { "$ref": "#/$defs/violationCause" },
        "replay_certificate": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "terminationDeadlockWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selected_root_id", "path", "applicable_state_id", "deadlock_state_id", "no_enabled_transition_proof", "cause", "replay_certificate"],
      "properties": {
        "kind": { "const": "termination_deadlock" },
        "selected_root_id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/path" },
        "applicable_state_id": { "$ref": "#/$defs/identifier" },
        "deadlock_state_id": { "$ref": "#/$defs/identifier" },
        "no_enabled_transition_proof": { "$ref": "#/$defs/artifactRef" },
        "cause": { "$ref": "#/$defs/violationCause" },
        "replay_certificate": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "safetyDisprovedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "verdict", "claim", "witness"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 1 },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "result_id": { "$ref": "#/$defs/identifier" },
        "result_kind": { "const": "DISPROVED.safety" },
        "verdict": { "const": "DISPROVED" },
        "claim": { "$ref": "#/$defs/claimIdentity" },
        "witness": { "$ref": "#/$defs/safetyWitness" }
      }
    },
    "temporalLassoDisprovedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "verdict", "claim", "witness"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 1 },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "result_id": { "$ref": "#/$defs/identifier" },
        "result_kind": { "const": "DISPROVED.temporal_lasso" },
        "verdict": { "const": "DISPROVED" },
        "claim": { "$ref": "#/$defs/claimIdentity" },
        "witness": { "$ref": "#/$defs/temporalLassoWitness" }
      }
    },
    "terminationDeadlockDisprovedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "verdict", "claim", "witness"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 1 },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "result_id": { "$ref": "#/$defs/identifier" },
        "result_kind": { "const": "DISPROVED.termination_deadlock" },
        "verdict": { "const": "DISPROVED" },
        "claim": { "$ref": "#/$defs/claimIdentity" },
        "witness": { "$ref": "#/$defs/terminationDeadlockWitness" }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executable_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resourceError": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "limit", "unit"],
          "properties": {
            "kind": { "const": "proof_engine_timeout" },
            "limit": { "type": "integer", "minimum": 1 },
            "unit": { "const": "milliseconds" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "limit", "unit"],
          "properties": {
            "kind": { "const": "proof_engine_memory_exhaustion" },
            "limit": { "type": "integer", "minimum": 1 },
            "unit": { "const": "bytes" }
          }
        }
      ]
    },
    "engineCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 },
        "resource": { "$ref": "#/$defs/resourceError" }
      }
    },
    "engineError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "artifact_id",
        "result_id",
        "result_kind",
        "status",
        "stage",
        "cause",
        "missing_references",
        "artifact_references",
        "applicable_tools"
      ],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 1 },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "result_id": { "$ref": "#/$defs/identifier" },
        "result_kind": { "const": "engine_error" },
        "status": { "const": "engine_error" },
        "stage": { "enum": ["boundary_validation", "compiler", "linker", "model", "coverage", "reachability", "proof", "replay", "certificate", "tool", "resource"] },
        "cause": { "$ref": "#/$defs/engineCause" },
        "missing_references": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "artifact_references": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
        "applicable_tools": { "type": "array", "items": { "$ref": "#/$defs/toolIdentity" } }
      }
    }
  }
}
