{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperray.dev/schemas/v1/model.schema.json",
  "title": "Hyperray finite transition model",
  "description": "This schema validates a model artifact shape. It does not prove transition semantics, finiteness, or correspondence with an executable image.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "model_id",
    "boundary_artifact",
    "executable_image",
    "semantics",
    "requirement_artifacts",
    "encoding"
  ],
  "properties": {
    "artifact_type": { "const": "hyperray_model" },
    "schema_version": { "const": 1 },
    "artifact_id": { "$ref": "#/$defs/identifier" },
    "model_id": { "$ref": "#/$defs/identifier" },
    "boundary_artifact": { "$ref": "#/$defs/artifactRef" },
    "executable_image": { "$ref": "#/$defs/artifactRef" },
    "semantics": { "$ref": "#/$defs/semanticsRefs" },
    "requirement_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "encoding": { "$ref": "#/$defs/explicitGraph" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "semanticsRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_instruction", "memory_model", "runtime", "scheduler", "environment"],
      "properties": {
        "target_instruction": { "$ref": "#/$defs/artifactRef" },
        "memory_model": { "$ref": "#/$defs/artifactRef" },
        "runtime": { "$ref": "#/$defs/artifactRef" },
        "scheduler": { "$ref": "#/$defs/artifactRef" },
        "environment": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "stateComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_class", "finite_domain_id", "cardinality"],
      "properties": {
        "component_id": { "$ref": "#/$defs/identifier" },
        "component_class": {
          "enum": [
            "machine_control",
            "register",
            "memory",
            "allocation",
            "memory_history",
            "runtime",
            "thread",
            "stack",
            "scheduler",
            "scheduler_history",
            "environment",
            "environment_history",
            "requirement_monitor"
          ]
        },
        "finite_domain_id": { "$ref": "#/$defs/identifier" },
        "cardinality": { "type": "integer", "minimum": 1 }
      }
    },
    "componentValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "value"],
      "properties": {
        "component_id": { "$ref": "#/$defs/identifier" },
        "value": true
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "component_values", "canonical_state_sha256"],
      "properties": {
        "state_id": { "$ref": "#/$defs/identifier" },
        "component_values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/componentValue" } },
        "canonical_state_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "machineTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "transition_id", "source_state_id", "target_state_id", "instruction_id", "semantic_case_id", "observation_symbol_ids"],
      "properties": {
        "kind": { "const": "machine_step" },
        "transition_id": { "$ref": "#/$defs/identifier" },
        "source_state_id": { "$ref": "#/$defs/identifier" },
        "target_state_id": { "$ref": "#/$defs/identifier" },
        "instruction_id": { "$ref": "#/$defs/identifier" },
        "semantic_case_id": { "$ref": "#/$defs/identifier" },
        "observation_symbol_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "environmentTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "transition_id", "source_state_id", "target_state_id", "environment_action_id", "outcome_id", "semantic_case_id", "observation_symbol_ids"],
      "properties": {
        "kind": { "const": "environment_step" },
        "transition_id": { "$ref": "#/$defs/identifier" },
        "source_state_id": { "$ref": "#/$defs/identifier" },
        "target_state_id": { "$ref": "#/$defs/identifier" },
        "environment_action_id": { "$ref": "#/$defs/identifier" },
        "outcome_id": { "$ref": "#/$defs/identifier" },
        "semantic_case_id": { "$ref": "#/$defs/identifier" },
        "observation_symbol_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "schedulerTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "transition_id", "source_state_id", "target_state_id", "scheduler_choice_id", "semantic_case_id", "observation_symbol_ids"],
      "properties": {
        "kind": { "const": "scheduler_step" },
        "transition_id": { "$ref": "#/$defs/identifier" },
        "source_state_id": { "$ref": "#/$defs/identifier" },
        "target_state_id": { "$ref": "#/$defs/identifier" },
        "scheduler_choice_id": { "$ref": "#/$defs/identifier" },
        "semantic_case_id": { "$ref": "#/$defs/identifier" },
        "observation_symbol_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "terminalStutterTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "transition_id", "source_state_id", "target_state_id", "outcome_kind", "query_ids", "semantic_case_id", "observation_symbol_ids"],
      "properties": {
        "kind": { "const": "terminal_stutter" },
        "transition_id": { "$ref": "#/$defs/identifier" },
        "source_state_id": { "$ref": "#/$defs/identifier" },
        "target_state_id": { "$ref": "#/$defs/identifier" },
        "outcome_kind": { "enum": ["normal_termination", "trap", "abort", "undefined_behavior", "capacity_error"] },
        "query_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "semantic_case_id": { "$ref": "#/$defs/identifier" },
        "observation_symbol_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "transition": {
      "oneOf": [
        { "$ref": "#/$defs/machineTransition" },
        { "$ref": "#/$defs/environmentTransition" },
        { "$ref": "#/$defs/schedulerTransition" },
        { "$ref": "#/$defs/terminalStutterTransition" }
      ]
    },
    "stateClassification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "nonterminal" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "observation_symbol_id"],
          "properties": {
            "kind": { "enum": ["normal_termination", "nonterminal_deadlock", "trap", "abort", "undefined_behavior", "capacity_error"] },
            "observation_symbol_id": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "stateLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "classification", "requirement_label_ids", "acceptance_ids", "error_ids"],
      "properties": {
        "state_id": { "$ref": "#/$defs/identifier" },
        "classification": { "$ref": "#/$defs/stateClassification" },
        "requirement_label_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "acceptance_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "error_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "explicitRoot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "root_id", "state_ids"],
          "properties": {
            "kind": { "const": "explicit_state_set" },
            "root_id": { "$ref": "#/$defs/identifier" },
            "state_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "root_id", "impossible_precondition_proof"],
          "properties": {
            "kind": { "const": "impossible_precondition_with_proof" },
            "root_id": { "$ref": "#/$defs/identifier" },
            "impossible_precondition_proof": { "$ref": "#/$defs/artifactRef" }
          }
        }
      ]
    },
    "explicitGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "encoding_version",
        "exact_state_count",
        "exact_transition_count",
        "state_components",
        "states",
        "transitions",
        "labels",
        "roots",
        "exact_state_equality"
      ],
      "properties": {
        "kind": { "const": "explicit_graph" },
        "encoding_version": { "const": 1 },
        "exact_state_count": { "type": "integer", "minimum": 1 },
        "exact_transition_count": { "type": "integer", "minimum": 0 },
        "state_components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stateComponent" },
          "allOf": [
            { "contains": { "properties": { "component_class": { "const": "machine_control" } }, "required": ["component_class"] }, "minContains": 1 },
            { "contains": { "properties": { "component_class": { "const": "memory" } }, "required": ["component_class"] }, "minContains": 1 },
            { "contains": { "properties": { "component_class": { "const": "runtime" } }, "required": ["component_class"] }, "minContains": 1 },
            { "contains": { "properties": { "component_class": { "const": "scheduler" } }, "required": ["component_class"] }, "minContains": 1 },
            { "contains": { "properties": { "component_class": { "const": "environment" } }, "required": ["component_class"] }, "minContains": 1 },
            { "contains": { "properties": { "component_class": { "const": "requirement_monitor" } }, "required": ["component_class"] }, "minContains": 1 }
          ]
        },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/state" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "labels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateLabels" } },
        "roots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/explicitRoot" } },
        "exact_state_equality": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "bitRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_class", "first_bit", "bit_count", "finite_domain_id"],
      "properties": {
        "component_id": { "$ref": "#/$defs/identifier" },
        "component_class": { "$ref": "#/$defs/stateComponent/properties/component_class" },
        "first_bit": { "type": "integer", "minimum": 0 },
        "bit_count": { "type": "integer", "minimum": 1 },
        "finite_domain_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "circuitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["circuit_kind", "format", "artifact", "interface_sha256"],
      "properties": {
        "circuit_kind": { "enum": ["initial_state", "next_state", "labels", "observations", "root_selection"] },
        "format": { "const": "hyperray_boolean_network.v1" },
        "artifact": { "$ref": "#/$defs/artifactRef" },
        "interface_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sequentialCircuit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "encoding_version",
        "state_bits",
        "nondeterministic_input_bits",
        "state_layout",
        "initial_state_circuit",
        "next_state_circuit",
        "label_circuit",
        "observation_circuit",
        "root_selection_circuit",
        "lowering_certificate"
      ],
      "properties": {
        "kind": { "const": "sequential_circuit" },
        "encoding_version": { "const": 1 },
        "state_bits": { "type": "integer", "minimum": 1 },
        "nondeterministic_input_bits": { "type": "integer", "minimum": 0 },
        "state_layout": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bitRange" } },
        "initial_state_circuit": {
          "allOf": [
            { "$ref": "#/$defs/circuitRef" },
            { "properties": { "circuit_kind": { "const": "initial_state" } } }
          ]
        },
        "next_state_circuit": {
          "allOf": [
            { "$ref": "#/$defs/circuitRef" },
            { "properties": { "circuit_kind": { "const": "next_state" } } }
          ]
        },
        "label_circuit": {
          "allOf": [
            { "$ref": "#/$defs/circuitRef" },
            { "properties": { "circuit_kind": { "const": "labels" } } }
          ]
        },
        "observation_circuit": {
          "allOf": [
            { "$ref": "#/$defs/circuitRef" },
            { "properties": { "circuit_kind": { "const": "observations" } } }
          ]
        },
        "root_selection_circuit": {
          "allOf": [
            { "$ref": "#/$defs/circuitRef" },
            { "properties": { "circuit_kind": { "const": "root_selection" } } }
          ]
        },
        "lowering_certificate": { "$ref": "#/$defs/artifactRef" }
      }
    }
  }
}
