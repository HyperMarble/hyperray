{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperray.dev/schemas/v1/requirement.schema.json",
  "title": "Hyperray finite-state requirement",
  "description": "This schema validates a requirement artifact shape. It does not prove that the monitor states the source contract correctly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "requirement_id",
    "name",
    "property",
    "monitor",
    "observation",
    "selected_roots",
    "fairness",
    "contract_provenance"
  ],
  "properties": {
    "artifact_type": { "const": "hyperray_requirement" },
    "schema_version": { "const": 1 },
    "artifact_id": { "$ref": "#/$defs/identifier" },
    "requirement_id": { "$ref": "#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1 },
    "property": { "$ref": "#/$defs/property" },
    "monitor": { "$ref": "#/$defs/monitor" },
    "observation": { "$ref": "#/$defs/observation" },
    "selected_roots": { "$ref": "#/$defs/selectedRoots" },
    "fairness": {
      "type": "array",
      "items": { "$ref": "#/$defs/fairnessClause" }
    },
    "contract_provenance": { "$ref": "#/$defs/contractProvenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "property": { "properties": { "kind": { "const": "safety" } }, "required": ["kind"] } },
        "required": ["property"]
      },
      "then": {
        "properties": { "monitor": { "properties": { "kind": { "const": "safety_monitor.v1" } }, "required": ["kind"] } }
      }
    },
    {
      "if": {
        "properties": { "property": { "properties": { "kind": { "const": "omega_regular" } }, "required": ["kind"] } },
        "required": ["property"]
      },
      "then": {
        "properties": { "monitor": { "properties": { "kind": { "const": "generalized_buchi_negation.v1" } }, "required": ["kind"] } }
      }
    },
    {
      "if": {
        "properties": { "property": { "properties": { "kind": { "const": "termination" } }, "required": ["kind"] } },
        "required": ["property"]
      },
      "then": {
        "properties": { "monitor": { "properties": { "kind": { "const": "termination_monitor.v1" } }, "required": ["kind"] } }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "formalPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logic", "expression", "free_variables"],
      "properties": {
        "logic": { "enum": ["propositional.v1", "bitvector.v1", "finite_relation.v1"] },
        "expression": { "type": "string", "minLength": 1 },
        "free_variables": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "property": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "violating_state", "violating_transition"],
          "properties": {
            "kind": { "const": "safety" },
            "violating_state": { "$ref": "#/$defs/formalPredicate" },
            "violating_transition": { "$ref": "#/$defs/formalPredicate" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "language", "monitor_interpretation"],
          "properties": {
            "kind": { "const": "omega_regular" },
            "language": { "const": "generalized_buchi_negation" },
            "monitor_interpretation": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "terminal_state", "nonterminal_deadlock", "infinite_nontermination"],
          "properties": {
            "kind": { "const": "termination" },
            "terminal_state": { "$ref": "#/$defs/formalPredicate" },
            "nonterminal_deadlock": { "$ref": "#/$defs/formalPredicate" },
            "infinite_nontermination": { "const": "accepted_by_monitor" }
          }
        }
      ]
    },
    "monitorState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id"],
      "properties": {
        "state_id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "monitorTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "source_state_id", "target_state_id", "observation_symbol_id", "guard"],
      "properties": {
        "transition_id": { "$ref": "#/$defs/identifier" },
        "source_state_id": { "$ref": "#/$defs/identifier" },
        "target_state_id": { "$ref": "#/$defs/identifier" },
        "observation_symbol_id": { "$ref": "#/$defs/identifier" },
        "guard": { "$ref": "#/$defs/formalPredicate" }
      }
    },
    "acceptanceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_id", "state_ids"],
      "properties": {
        "acceptance_id": { "$ref": "#/$defs/identifier" },
        "state_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "safetyMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "states", "initial_state_id", "transitions", "violating_state_ids", "violating_transition_ids"],
      "properties": {
        "kind": { "const": "safety_monitor.v1" },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/monitorState" } },
        "initial_state_id": { "$ref": "#/$defs/identifier" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/monitorTransition" } },
        "violating_state_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "violating_transition_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "buchiMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "states", "initial_state_id", "transitions", "acceptance_sets"],
      "properties": {
        "kind": { "const": "generalized_buchi_negation.v1" },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/monitorState" } },
        "initial_state_id": { "$ref": "#/$defs/identifier" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/monitorTransition" } },
        "acceptance_sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptanceSet" } }
      }
    },
    "terminationMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "states", "initial_state_id", "transitions", "acceptance_sets", "deadlock_predicate"],
      "properties": {
        "kind": { "const": "termination_monitor.v1" },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/monitorState" } },
        "initial_state_id": { "$ref": "#/$defs/identifier" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/monitorTransition" } },
        "acceptance_sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptanceSet" } },
        "deadlock_predicate": { "$ref": "#/$defs/formalPredicate" }
      }
    },
    "monitor": {
      "oneOf": [
        { "$ref": "#/$defs/safetyMonitor" },
        { "$ref": "#/$defs/buchiMonitor" },
        { "$ref": "#/$defs/terminationMonitor" }
      ]
    },
    "observationSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol_id", "payload_domain_ids"],
      "properties": {
        "symbol_id": { "$ref": "#/$defs/identifier" },
        "payload_domain_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "observationFunction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "relation_artifact", "domain_count", "totality_proof"],
          "properties": {
            "encoding": { "const": "explicit_relation.v1" },
            "relation_artifact": { "$ref": "#/$defs/artifactRef" },
            "domain_count": { "type": "integer", "minimum": 1 },
            "totality_proof": { "$ref": "#/$defs/artifactRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "decision_artifact", "format_version", "totality_proof"],
          "properties": {
            "encoding": { "const": "decision_diagram.v1" },
            "decision_artifact": { "$ref": "#/$defs/artifactRef" },
            "format_version": { "const": 1 },
            "totality_proof": { "$ref": "#/$defs/artifactRef" }
          }
        }
      ]
    },
    "terminalObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal_termination", "nonterminal_deadlock", "trap", "abort", "undefined_behavior", "capacity_error"],
      "properties": {
        "normal_termination": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "nonterminal_deadlock": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "trap": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "abort": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "undefined_behavior": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "capacity_error": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alphabet", "step_function", "terminal_function"],
      "properties": {
        "alphabet": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observationSymbol" } },
        "step_function": { "$ref": "#/$defs/observationFunction" },
        "terminal_function": { "$ref": "#/$defs/terminalObservation" }
      }
    },
    "selectedRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_artifact", "query_id", "root_ids"],
      "properties": {
        "boundary_artifact": { "$ref": "#/$defs/artifactRef" },
        "query_id": { "$ref": "#/$defs/identifier" },
        "root_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "fairnessClause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fairness_id", "kind", "subject_ids", "acceptance_ids", "formal_predicate", "provenance"],
      "properties": {
        "fairness_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["weak", "strong", "justice", "compassion", "none"] },
        "subject_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "acceptance_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "formal_predicate": { "$ref": "#/$defs/formalPredicate" },
        "provenance": { "$ref": "#/$defs/contractProvenance" }
      }
    },
    "contractProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_artifact", "locator", "text_sha256", "authority"],
      "properties": {
        "contract_artifact": { "$ref": "#/$defs/artifactRef" },
        "locator": { "type": "string", "minLength": 1 },
        "text_sha256": { "$ref": "#/$defs/sha256" },
        "authority": { "enum": ["task_text", "accepted_specification", "named_external_contract"] }
      }
    }
  }
}
