{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperray.dev/schemas/v2/result.schema.json",
  "title": "Hyperray version 2 symbolic proof result or engine error",
  "description": "This schema separates logic verdicts from engine errors and records circuit valuations instead of enumerated machine nodes. A checker must validate every certificate and witness.",
  "oneOf": [
    { "$ref": "#/$defs/provedResult" },
    { "$ref": "#/$defs/safetyDisprovedResult" },
    { "$ref": "#/$defs/temporalDisprovedResult" },
    { "$ref": "#/$defs/deadlockDisprovedResult" },
    { "$ref": "#/$defs/engineError" }
  ],
  "$defs": {
    "claimIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "boundary", "model", "model_encoding", "executable_image", "compiler_inventory", "semantics", "coverage", "trust_assumptions", "query_id", "selected_root_ids"],
      "properties": {
        "requirement": { "$ref": "common.schema.json#/$defs/v2RequirementRef" },
        "boundary": { "$ref": "common.schema.json#/$defs/artifactRef" },
        "model": { "$ref": "common.schema.json#/$defs/v2ModelRef" },
        "model_encoding": { "const": "sequential_circuit" },
        "executable_image": { "$ref": "common.schema.json#/$defs/artifactRef" },
        "compiler_inventory": { "$ref": "common.schema.json#/$defs/artifactRef" },
        "semantics": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
        "coverage": { "$ref": "common.schema.json#/$defs/v2CoverageRef" },
        "trust_assumptions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
        "query_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "selected_root_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
      }
    },
    "safetyProofCertificateRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/validatedCertificateRef" },
        { "properties": { "certificate_kind": { "enum": ["safety_inductive_invariant", "symbolic_reachable_fixed_point", "proved_completeness_threshold"] } }, "required": ["certificate_kind"] }
      ]
    },
    "temporalProofCertificateRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/validatedCertificateRef" },
        { "properties": { "certificate_kind": { "enum": ["symbolic_reachable_fixed_point", "proved_completeness_threshold"] } }, "required": ["certificate_kind"] }
      ]
    },
    "safetyProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "validated_certificate"],
      "properties": {
        "kind": { "const": "safety" },
        "validated_certificate": { "$ref": "#/$defs/safetyProofCertificateRef" }
      }
    },
    "temporalProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "validated_certificate"],
      "properties": {
        "kind": { "const": "omega_regular" },
        "validated_certificate": { "$ref": "#/$defs/temporalProofCertificateRef" }
      }
    },
    "terminationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "validated_certificate"],
      "properties": {
        "kind": { "const": "termination" },
        "validated_certificate": { "$ref": "#/$defs/temporalProofCertificateRef" }
      }
    },
    "provedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "verdict", "claim", "proof"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 2 },
        "artifact_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_kind": { "const": "PROVED" },
        "verdict": { "const": "PROVED" },
        "claim": { "$ref": "#/$defs/claimIdentity" },
        "proof": { "oneOf": [{ "$ref": "#/$defs/safetyProof" }, { "$ref": "#/$defs/temporalProof" }, { "$ref": "#/$defs/terminationProof" }] }
      }
    },
    "observationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol_id", "payload"],
      "properties": {
        "symbol_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "payload": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/bitVector" } }
      }
    },
    "activeEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effect_id", "semantic_case_ids"],
          "properties": {
            "kind": { "const": "machine_step_effect" },
            "effect_id": { "$ref": "common.schema.json#/$defs/identifier" },
            "semantic_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effect_id", "semantic_case_ids"],
          "properties": {
            "kind": { "enum": ["environment_step_effect", "scheduler_step_effect", "terminal_stutter_effect"] },
            "effect_id": { "$ref": "common.schema.json#/$defs/identifier" },
            "semantic_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
          }
        }
      ]
    },
    "traceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "current_state", "choice", "choice_valid", "step_enabled", "next_state", "active_effects", "observations"],
      "properties": {
        "step_index": { "type": "integer", "minimum": 0 },
        "current_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "choice": { "$ref": "common.schema.json#/$defs/bitVector" },
        "choice_valid": { "const": true },
        "step_enabled": { "const": true },
        "next_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "active_effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/activeEffect" } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observationValue" } }
      }
    },
    "circuitTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "initial_state", "steps"],
      "properties": {
        "kind": { "const": "circuit_trace" },
        "initial_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/traceStep" } }
      }
    },
    "cycleTrace": {
      "allOf": [
        { "$ref": "#/$defs/circuitTrace" },
        { "properties": { "steps": { "minItems": 1 } }, "required": ["steps"] }
      ]
    },
    "violationLocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path_position", "state"],
          "properties": {
            "kind": { "const": "state" },
            "path_position": { "type": "integer", "minimum": 0 },
            "state": { "$ref": "common.schema.json#/$defs/bitVector" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "step_index"],
          "properties": {
            "kind": { "const": "step" },
            "step_index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate_id", "monitor_state_id", "message"],
      "properties": {
        "predicate_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "monitor_state_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "witnessReplayRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/validatedCertificateRef" },
        { "properties": { "certificate_kind": { "const": "witness_replay" } }, "required": ["certificate_kind"] }
      ]
    },
    "safetyWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selected_root_id", "path", "applicable_state", "violation", "cause", "validated_replay_certificate"],
      "properties": {
        "kind": { "const": "safety" },
        "selected_root_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "path": { "$ref": "#/$defs/circuitTrace" },
        "applicable_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "violation": { "$ref": "#/$defs/violationLocation" },
        "cause": { "$ref": "#/$defs/cause" },
        "validated_replay_certificate": { "$ref": "#/$defs/witnessReplayRef" }
      }
    },
    "temporalWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selected_root_id", "prefix", "cycle", "loop_entry_state", "loop_closing_state", "applicable_state", "acceptance_ids", "fairness_ids", "cause", "validated_replay_certificate"],
      "properties": {
        "kind": { "const": "temporal_lasso" },
        "selected_root_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "prefix": { "$ref": "#/$defs/circuitTrace" },
        "cycle": { "$ref": "#/$defs/cycleTrace" },
        "loop_entry_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "loop_closing_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "applicable_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "acceptance_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "fairness_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "cause": { "$ref": "#/$defs/cause" },
        "validated_replay_certificate": { "$ref": "#/$defs/witnessReplayRef" }
      }
    },
    "deadlockWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selected_root_id", "path", "applicable_state", "deadlock_state", "choice_domain_artifact", "cause", "validated_replay_certificate"],
      "properties": {
        "kind": { "const": "termination_deadlock" },
        "selected_root_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "path": { "$ref": "#/$defs/circuitTrace" },
        "applicable_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "deadlock_state": { "$ref": "common.schema.json#/$defs/bitVector" },
        "choice_domain_artifact": { "$ref": "common.schema.json#/$defs/artifactRef" },
        "cause": { "$ref": "#/$defs/cause" },
        "validated_replay_certificate": { "$ref": "#/$defs/witnessReplayRef" }
      }
    },
    "safetyDisprovedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "verdict", "claim", "witness"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 2 },
        "artifact_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_kind": { "const": "DISPROVED.safety" },
        "verdict": { "const": "DISPROVED" },
        "claim": { "$ref": "#/$defs/claimIdentity" },
        "witness": { "$ref": "#/$defs/safetyWitness" }
      }
    },
    "temporalDisprovedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "verdict", "claim", "witness"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 2 },
        "artifact_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_kind": { "const": "DISPROVED.temporal_lasso" },
        "verdict": { "const": "DISPROVED" },
        "claim": { "$ref": "#/$defs/claimIdentity" },
        "witness": { "$ref": "#/$defs/temporalWitness" }
      }
    },
    "deadlockDisprovedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "verdict", "claim", "witness"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 2 },
        "artifact_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_kind": { "const": "DISPROVED.termination_deadlock" },
        "verdict": { "const": "DISPROVED" },
        "claim": { "$ref": "#/$defs/claimIdentity" },
        "witness": { "$ref": "#/$defs/deadlockWitness" }
      }
    },
    "resourceError": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "limit", "unit"],
          "properties": {
            "kind": { "const": "proof_engine_timeout" },
            "limit": { "type": "integer", "minimum": 1 },
            "unit": { "const": "milliseconds" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "limit", "unit"],
          "properties": {
            "kind": { "const": "proof_engine_memory_exhaustion" },
            "limit": { "type": "integer", "minimum": 1 },
            "unit": { "const": "bytes" }
          }
        }
      ]
    },
    "engineCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 },
        "resource": { "$ref": "#/$defs/resourceError" }
      }
    },
    "engineError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "artifact_id", "result_id", "result_kind", "status", "stage", "cause", "missing_references", "artifact_references", "applicable_tools"],
      "properties": {
        "artifact_type": { "const": "hyperray_result" },
        "schema_version": { "const": 2 },
        "artifact_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "result_kind": { "const": "engine_error" },
        "status": { "const": "engine_error" },
        "stage": { "enum": ["boundary_validation", "compiler", "linker", "model", "coverage", "reachability", "proof", "replay", "certificate", "tool", "resource"] },
        "cause": { "$ref": "#/$defs/engineCause" },
        "missing_references": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "artifact_references": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
        "applicable_tools": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/toolIdentity" } }
      }
    }
  }
}
