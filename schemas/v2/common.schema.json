{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperray.dev/schemas/v2/common.schema.json",
  "title": "Hyperray version 2 common contract types",
  "description": "These definitions validate artifact shapes. They do not prove reference consistency, circuit meaning, or proof validity.",
  "$ref": "#/$defs/artifactRef",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exactCount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "schema_version", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_type": { "$ref": "#/$defs/identifier" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "modelIrRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": { "artifact_type": { "const": "model_ir" } },
          "required": ["artifact_type"]
        }
      ]
    },
    "proofArtifactRef": {
      "description": "This reference identifies raw proof evidence. It is not a validation receipt or a verdict authority.",
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": { "artifact_type": { "const": "proof_evidence" } },
          "required": ["artifact_type"]
        }
      ]
    },
    "validatedCertificateRef": {
      "description": "A consumer must resolve this digest to a validated-certificate envelope and authenticate its external receipt against the named trust anchor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "schema_version", "certificate_kind", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_type": { "const": "hyperray_validated_certificate" },
        "schema_version": { "const": 2 },
        "certificate_kind": {
          "enum": [
            "circuit_lowering_equivalence",
            "symbolic_coverage_equivalence",
            "safety_inductive_invariant",
            "explicit_reachable_fixed_point",
            "symbolic_reachable_fixed_point",
            "proved_completeness_threshold",
            "symbolic_exact_count",
            "witness_replay"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "v2ModelRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "artifact_type": { "const": "hyperray_model" }, "schema_version": { "const": 2 } }, "required": ["artifact_type", "schema_version"] }
      ]
    },
    "v2RequirementRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "artifact_type": { "const": "hyperray_requirement" }, "schema_version": { "const": 2 } }, "required": ["artifact_type", "schema_version"] }
      ]
    },
    "v2CoverageRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "artifact_type": { "const": "hyperray_semantic_coverage" }, "schema_version": { "const": 2 } }, "required": ["artifact_type", "schema_version"] }
      ]
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_sha256", "arguments"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "arguments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "proofRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "statement_artifact", "proof_artifact"],
      "properties": {
        "obligation_id": { "$ref": "#/$defs/identifier" },
        "statement_artifact": {
          "allOf": [
            { "$ref": "#/$defs/artifactRef" },
            { "properties": { "artifact_type": { "const": "proof_obligation" } }, "required": ["artifact_type"] }
          ]
        },
        "proof_artifact": { "$ref": "#/$defs/proofArtifactRef" }
      }
    },
    "bitRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_class", "first_bit", "bit_count", "finite_domain_id"],
      "properties": {
        "component_id": { "$ref": "#/$defs/identifier" },
        "component_class": {
          "enum": [
            "machine_control",
            "register",
            "memory",
            "allocation",
            "memory_history",
            "runtime",
            "thread",
            "stack",
            "scheduler",
            "scheduler_history",
            "environment",
            "environment_history",
            "requirement_monitor",
            "choice"
          ]
        },
        "first_bit": { "type": "integer", "minimum": 0 },
        "bit_count": { "type": "integer", "minimum": 1 },
        "finite_domain_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "bitVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "width", "value"],
      "properties": {
        "encoding": { "const": "binary_msb_first" },
        "width": { "type": "integer", "minimum": 1 },
        "value": { "type": "string", "pattern": "^[01]+$" }
      }
    },
    "circuitPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_id", "direction", "role", "bit_width", "canonical_index"],
      "properties": {
        "port_id": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["input", "output"] },
        "role": {
          "enum": [
            "current_state",
            "nondeterministic_choice",
            "next_state",
            "initial_predicate",
            "choice_valid_predicate",
            "step_enabled_predicate",
            "effect_predicate",
            "terminal_predicate",
            "root_predicate",
            "observation_present",
            "observation_payload",
            "requirement_state_label",
            "requirement_step_label",
            "acceptance_predicate",
            "fairness_predicate"
          ]
        },
        "bit_width": { "type": "integer", "minimum": 1 },
        "canonical_index": { "type": "integer", "minimum": 0 }
      }
    },
    "machineEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effect_id", "guard_port_id", "enabled_port_id", "next_state_port_id", "image_instruction_ids", "semantic_case_ids", "observation_port_ids", "proof_obligation_id"],
      "properties": {
        "kind": { "const": "machine_step_effect" },
        "effect_id": { "$ref": "#/$defs/identifier" },
        "guard_port_id": { "$ref": "#/$defs/identifier" },
        "enabled_port_id": { "$ref": "#/$defs/identifier" },
        "next_state_port_id": { "$ref": "#/$defs/identifier" },
        "image_instruction_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "semantic_case_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "observation_port_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "proof_obligation_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "environmentEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effect_id", "guard_port_id", "enabled_port_id", "next_state_port_id", "environment_action_id", "outcome_id", "semantic_case_ids", "observation_port_ids", "proof_obligation_id"],
      "properties": {
        "kind": { "const": "environment_step_effect" },
        "effect_id": { "$ref": "#/$defs/identifier" },
        "guard_port_id": { "$ref": "#/$defs/identifier" },
        "enabled_port_id": { "$ref": "#/$defs/identifier" },
        "next_state_port_id": { "$ref": "#/$defs/identifier" },
        "environment_action_id": { "$ref": "#/$defs/identifier" },
        "outcome_id": { "$ref": "#/$defs/identifier" },
        "semantic_case_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "observation_port_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "proof_obligation_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "schedulerEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effect_id", "guard_port_id", "enabled_port_id", "next_state_port_id", "scheduler_choice_id", "semantic_case_ids", "observation_port_ids", "proof_obligation_id"],
      "properties": {
        "kind": { "const": "scheduler_step_effect" },
        "effect_id": { "$ref": "#/$defs/identifier" },
        "guard_port_id": { "$ref": "#/$defs/identifier" },
        "enabled_port_id": { "$ref": "#/$defs/identifier" },
        "next_state_port_id": { "$ref": "#/$defs/identifier" },
        "scheduler_choice_id": { "$ref": "#/$defs/identifier" },
        "semantic_case_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "observation_port_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "proof_obligation_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "terminalEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effect_id", "guard_port_id", "enabled_port_id", "next_state_port_id", "outcome_kind", "query_ids", "semantic_case_ids", "observation_port_ids", "proof_obligation_id"],
      "properties": {
        "kind": { "const": "terminal_stutter_effect" },
        "effect_id": { "$ref": "#/$defs/identifier" },
        "guard_port_id": { "$ref": "#/$defs/identifier" },
        "enabled_port_id": { "$ref": "#/$defs/identifier" },
        "next_state_port_id": { "$ref": "#/$defs/identifier" },
        "outcome_kind": { "enum": ["normal_termination", "nonterminal_deadlock", "trap", "abort", "undefined_behavior", "capacity_error"] },
        "query_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "semantic_case_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "observation_port_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "proof_obligation_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "modelEffect": {
      "oneOf": [
        { "$ref": "#/$defs/machineEffect" },
        { "$ref": "#/$defs/environmentEffect" },
        { "$ref": "#/$defs/schedulerEffect" },
        { "$ref": "#/$defs/terminalEffect" }
      ]
    },
    "semanticOrigin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "image_instruction_ids"],
          "properties": {
            "kind": { "const": "machine_instruction" },
            "image_instruction_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "environment_action_id", "outcome_id"],
          "properties": {
            "kind": { "const": "environment_action" },
            "environment_action_id": { "$ref": "#/$defs/identifier" },
            "outcome_id": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "scheduler_choice_id"],
          "properties": {
            "kind": { "const": "scheduler_choice" },
            "scheduler_choice_id": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "synthetic_operation_id"],
          "properties": {
            "kind": { "const": "declared_synthetic" },
            "synthetic_operation_id": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    }
  }
}
