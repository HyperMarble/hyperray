{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperray.dev/schemas/v2/validated-certificate.schema.json",
  "title": "Hyperray version 2 validated certificate envelope",
  "description": "This envelope binds a proposal to an external validation receipt, policy, and trust anchor. Schema validation does not authenticate the receipt or validate the proof.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "artifact_id", "certificate_id", "certificate_kind", "proposal", "validation_receipt", "validation_policy", "trust_anchor", "validation_scope_sha256"],
  "properties": {
    "artifact_type": { "const": "hyperray_validated_certificate" },
    "schema_version": { "const": 2 },
    "artifact_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "certificate_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "certificate_kind": { "$ref": "common.schema.json#/$defs/validatedCertificateRef/properties/certificate_kind" },
    "proposal": { "$ref": "#/$defs/proposalRef" },
    "validation_receipt": { "$ref": "#/$defs/receiptRef" },
    "validation_policy": { "$ref": "#/$defs/policyRef" },
    "trust_anchor": { "$ref": "#/$defs/trustAnchorRef" },
    "validation_scope_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "proposalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "schema_version", "certificate_kind", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "artifact_type": { "const": "hyperray_certificate_proposal" },
        "schema_version": { "const": 2 },
        "certificate_kind": { "$ref": "common.schema.json#/$defs/validatedCertificateRef/properties/certificate_kind" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "receiptRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/artifactRef" },
        { "properties": { "artifact_type": { "const": "certificate_validation_receipt" } }, "required": ["artifact_type"] }
      ]
    },
    "policyRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/artifactRef" },
        { "properties": { "artifact_type": { "const": "certificate_validation_policy" } }, "required": ["artifact_type"] }
      ]
    },
    "trustAnchorRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/artifactRef" },
        { "properties": { "artifact_type": { "const": "certificate_trust_anchor" } }, "required": ["artifact_type"] }
      ]
    }
  }
}
