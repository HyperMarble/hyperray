{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperray.dev/schemas/v2/certificate.schema.json",
  "title": "Hyperray version 2 typed certificate proposal",
  "description": "This schema describes raw proof artifacts and obligations. A conforming proposal is not a validated certificate and does not authorize a verdict.",
  "$comment": "Niemetz et al., CAV 2018, describe BTOR2 as a word-level model-checking format and intermediate format: https://doi.org/10.1007/978-3-319-96145-3_32. Therefore, a BTOR2 artifact can be model_ir but cannot be proof_evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "certificate_id",
    "certificate_kind",
    "subject_artifacts",
    "producer",
    "evidence"
  ],
  "properties": {
    "artifact_type": { "const": "hyperray_certificate_proposal" },
    "schema_version": { "const": 2 },
    "artifact_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "certificate_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "certificate_kind": {
      "enum": [
        "circuit_lowering_equivalence",
        "symbolic_coverage_equivalence",
        "safety_inductive_invariant",
        "explicit_reachable_fixed_point",
        "symbolic_reachable_fixed_point",
        "proved_completeness_threshold",
        "symbolic_exact_count",
        "witness_replay"
      ]
    },
    "subject_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/artifactRef" }
    },
    "producer": { "$ref": "common.schema.json#/$defs/toolIdentity" },
    "evidence": true
  },
  "allOf": [
    {
      "if": { "properties": { "certificate_kind": { "const": "circuit_lowering_equivalence" } }, "required": ["certificate_kind"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/loweringEvidence" } } }
    },
    {
      "if": { "properties": { "certificate_kind": { "const": "symbolic_coverage_equivalence" } }, "required": ["certificate_kind"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/coverageEvidence" } } }
    },
    {
      "if": { "properties": { "certificate_kind": { "const": "safety_inductive_invariant" } }, "required": ["certificate_kind"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/invariantEvidence" } } }
    },
    {
      "if": { "properties": { "certificate_kind": { "const": "explicit_reachable_fixed_point" } }, "required": ["certificate_kind"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/explicitFixedPointEvidence" } } }
    },
    {
      "if": { "properties": { "certificate_kind": { "const": "symbolic_reachable_fixed_point" } }, "required": ["certificate_kind"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/symbolicFixedPointEvidence" } } }
    },
    {
      "if": { "properties": { "certificate_kind": { "const": "proved_completeness_threshold" } }, "required": ["certificate_kind"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/thresholdEvidence" } } }
    },
    {
      "if": { "properties": { "certificate_kind": { "const": "symbolic_exact_count" } }, "required": ["certificate_kind"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/countEvidence" } } }
    },
    {
      "if": { "properties": { "certificate_kind": { "const": "witness_replay" } }, "required": ["certificate_kind"] },
      "then": { "properties": { "evidence": { "$ref": "#/$defs/replayEvidence" } } }
    }
  ],
  "$defs": {
    "loweringRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_encoding", "initial", "choice_validity", "step_enabled", "next_state", "effects", "terminal_labels", "observations", "roots", "requirement_labels", "acceptance", "fairness"],
      "properties": {
        "state_encoding": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "initial": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "choice_validity": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "step_enabled": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "next_state": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "effects": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "terminal_labels": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "observations": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "roots": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "requirement_labels": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "acceptance": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "fairness": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "loweringEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_semantics", "target_model_ir", "interface_sha256", "proof_records"],
      "properties": {
        "source_semantics": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
        "target_model_ir": { "$ref": "common.schema.json#/$defs/modelIrRef" },
        "interface_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "proof_records": { "$ref": "#/$defs/loweringRecords" }
      }
    },
    "coverageRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_dispositions", "mapped_forward_paths", "eliminated_equivalence", "compiler_output_reverse_map", "image_instruction_reverse_map", "semantic_case_reverse_map", "model_effect_reverse_map", "exact_roots", "query_root_applicability", "exact_counts", "artifact_digest_resolution"],
      "properties": {
        "inventory_dispositions": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "mapped_forward_paths": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "eliminated_equivalence": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "compiler_output_reverse_map": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "image_instruction_reverse_map": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "semantic_case_reverse_map": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "model_effect_reverse_map": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "exact_roots": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "query_root_applicability": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "exact_counts": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "artifact_digest_resolution": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "coverageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_artifact", "model_artifact", "proof_records"],
      "properties": {
        "coverage_artifact": { "$ref": "common.schema.json#/$defs/v2CoverageRef" },
        "model_artifact": { "$ref": "common.schema.json#/$defs/v2ModelRef" },
        "proof_records": { "$ref": "#/$defs/coverageRecords" }
      }
    },
    "invariantEvidence": {
      "$comment": "Bradley defines initiation and consecution and reports an inductive strengthening for a successful IC3 safety proof: https://doi.org/10.1007/978-3-642-18275-4_7.",
      "type": "object",
      "additionalProperties": false,
      "required": ["property_kind", "model_encoding", "invariant_artifact", "initiation", "consecution", "state_safety", "transition_safety"],
      "properties": {
        "property_kind": { "const": "safety" },
        "model_encoding": { "enum": ["explicit_graph", "sequential_circuit"] },
        "invariant_artifact": { "$ref": "common.schema.json#/$defs/proofArtifactRef" },
        "initiation": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "consecution": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "state_safety": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "transition_safety": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "fixedPointRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_inclusion", "successor_closure", "convergence", "property"],
      "properties": {
        "initial_inclusion": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "successor_closure": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "convergence": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "property": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "explicitFixedPointEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_kind", "model_encoding", "fixed_point_artifact", "exact_reachable_state_count", "exact_reachable_step_count", "proof_records"],
      "properties": {
        "property_kind": { "enum": ["safety", "omega_regular", "termination"] },
        "model_encoding": { "const": "explicit_graph" },
        "fixed_point_artifact": { "$ref": "common.schema.json#/$defs/proofArtifactRef" },
        "exact_reachable_state_count": { "$ref": "common.schema.json#/$defs/exactCount" },
        "exact_reachable_step_count": { "$ref": "common.schema.json#/$defs/exactCount" },
        "proof_records": { "$ref": "#/$defs/fixedPointRecords" }
      }
    },
    "symbolicFixedPointEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_kind", "model_encoding", "fixed_point_artifact", "proof_records"],
      "properties": {
        "property_kind": { "enum": ["safety", "omega_regular", "termination"] },
        "model_encoding": { "const": "sequential_circuit" },
        "fixed_point_artifact": { "$ref": "common.schema.json#/$defs/proofArtifactRef" },
        "proof_records": { "$ref": "#/$defs/fixedPointRecords" }
      }
    },
    "thresholdEvidence": {
      "$comment": "Clarke, Kroening, Ouaknine, and Strichman define a completeness threshold whose bounded absence of counterexamples implies the property: https://people.mpi-sws.org/~joel/publications/compbmc04.pdf.",
      "type": "object",
      "additionalProperties": false,
      "required": ["property_kind", "model_encoding", "threshold", "path_measure", "threshold_proof", "bounded_absence_proof"],
      "properties": {
        "property_kind": { "enum": ["safety", "omega_regular", "termination"] },
        "model_encoding": { "enum": ["explicit_graph", "sequential_circuit"] },
        "threshold": { "$ref": "common.schema.json#/$defs/exactCount" },
        "path_measure": { "const": "number_of_steps" },
        "threshold_proof": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "bounded_absence_proof": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "countEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counted_set", "exact_count", "count_proof"],
      "properties": {
        "counted_set": { "enum": ["model_effect_regions", "enabled_choice_assignments", "root_assignments", "circuit_nodes", "circuit_ports"] },
        "exact_count": { "$ref": "common.schema.json#/$defs/exactCount" },
        "count_proof": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "safetyReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "violation"],
      "properties": {
        "kind": { "const": "safety" },
        "path": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "violation": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "temporalReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prefix", "cycle_closure", "acceptance", "fairness"],
      "properties": {
        "kind": { "const": "temporal_lasso" },
        "prefix": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "cycle_closure": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "acceptance": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "fairness": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "deadlockReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "terminal_policy", "no_valid_enabled_choice"],
      "properties": {
        "kind": { "const": "termination_deadlock" },
        "path": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "terminal_policy": { "$ref": "common.schema.json#/$defs/proofRecord" },
        "no_valid_enabled_choice": { "$ref": "common.schema.json#/$defs/proofRecord" }
      }
    },
    "replayEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_encoding", "result_artifact", "replay"],
      "properties": {
        "model_encoding": { "const": "sequential_circuit" },
        "result_artifact": { "$ref": "common.schema.json#/$defs/artifactRef" },
        "replay": {
          "oneOf": [
            { "$ref": "#/$defs/safetyReplay" },
            { "$ref": "#/$defs/temporalReplay" },
            { "$ref": "#/$defs/deadlockReplay" }
          ]
        }
      }
    }
  }
}
