+// Public memory reads exercise both unique and ambiguous concrete-region overlap.
+// A region-constrained sample must never remove a valid address outside the region.
+use crate::bitvector::{b64::B64, BV};
+use crate::error::ExecError;
+use crate::ir::Val;
+use crate::memory::Memory;
+use crate::smt::smtlib::{bits64, Exp, Ty};
+use crate::smt::{Config, Context, ReadOpts, Solver};
+use crate::source_loc::SourceLoc;
+
+#[test]
+fn unique_address_reads_declared_concrete_byte() -> Result<(), ExecError> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::<B64>::new(&context);
+    let mut memory = Memory::new();
+    memory.add_concrete_region(0x1000..0x1001, [(0x1000, 0x77)].into_iter().collect());
+    let address = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+    solver.assert_eq(Exp::Var(address), bits64(0x1000, 64));
+    let result =
+        memory.read(Val::Unit, Val::Symbolic(address), Val::I128(1), &mut solver, false, ReadOpts::default())?;
+    assert!(matches!(result, Val::Bits(value) if value == B64::new(0x77, 8)));
+    assert!(solver.check_sat(SourceLoc::unknown()).is_sat()?);
+    Ok(())
+}
+
+#[test]
+fn ambiguous_overlap_retains_inside_and_outside_addresses() -> Result<(), ExecError> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::<B64>::new(&context);
+    let mut memory = Memory::new();
+    memory.add_concrete_region(0x1000..0x1001, [(0x1000, 0x77)].into_iter().collect());
+    let address = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+    let inside = Exp::Eq(Box::new(Exp::Var(address)), Box::new(bits64(0x1000, 64)));
+    let outside = Exp::Eq(Box::new(Exp::Var(address)), Box::new(bits64(0x2000, 64)));
+    solver.assert(Exp::Or(Box::new(inside.clone()), Box::new(outside.clone())));
+    let result = memory.read(Val::Unit, Val::Symbolic(address), Val::I128(1), &mut solver, false, ReadOpts::default());
+    assert!(matches!(result, Err(ExecError::BadRead("Possible symbolic address overlap"))));
+    assert!(solver.check_sat_with(&inside, SourceLoc::unknown()).is_sat()?);
+    assert!(solver.check_sat_with(&outside, SourceLoc::unknown()).is_sat()?);
+    Ok(())
+}
