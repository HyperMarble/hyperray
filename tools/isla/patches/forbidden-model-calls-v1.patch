+// Candidate request tests reject features absent from the sequential contract.
+// A default axiomatic request retains its existing behavior.
+use super::*;
+use crate::litmus::exp::{Exp, Loc};
+use isla_lib::bitvector::b64::B64;
+
+#[path = "sequential_candidate_solver_tests.rs"]
+mod solver;
+
+#[test]
+fn rejects_graphs_and_extra_smt() {
+    assert!(validate(MemoryProfile::Sequential, GraphMode::ASCII, &[], false).is_err());
+    assert!(validate(MemoryProfile::Sequential, GraphMode::Dot, &[], false).is_err());
+    let extra = [("custom".to_string(), "(assert false)".to_string())];
+    assert!(validate(MemoryProfile::Sequential, GraphMode::Disabled, &extra, false).is_err());
+    assert!(validate(MemoryProfile::Axiomatic, GraphMode::Dot, &extra, true).is_ok());
+    assert!(validate(MemoryProfile::Sequential, GraphMode::Disabled, &[], false).is_ok());
+    assert!(validate(MemoryProfile::Sequential, GraphMode::Disabled, &[], true).is_err());
+}
+
+#[test]
+fn rejects_memory_and_unresolved_register_assertions() {
+    let writes = HashMap::<(Name, usize), &Val<B64>>::new();
+    let memory = Exp::EqLoc(Loc::LastWriteTo { address: 4096, bytes: 8 }, Box::new(Exp::Nat(0)));
+    assert!(crate::smt_events::sequential_assertion(&memory, &writes).is_err());
+    let register = Exp::EqLoc(Loc::Register { reg: Name::from_u32(1), thread_id: 0 }, Box::new(Exp::Nat(0)));
+    assert!(crate::smt_events::sequential_assertion(&register, &writes).is_err());
+    let value = Val::<B64>::Bool(true);
+    let writes = HashMap::from([((Name::from_u32(1), 0), &value)]);
+    assert!(crate::smt_events::sequential_assertion(&register, &writes).is_err());
+    assert!(crate::smt_events::sequential_assertion(&Exp::Label("unknown".to_string()), &writes).is_err());
+    let application = Exp::App("unknown".to_string(), vec![], HashMap::from([("key".to_string(), Exp::True)]));
+    assert!(crate::smt_events::sequential_assertion(&application, &writes).is_err());
+}
