@@ -0,0 +1,39 @@
+// Resolution uses actual function declarations and enabled instrumentation.
+// A symbol alone must not satisfy the model-call contract.
+use super::*;
+use isla_lib::ir::{IRTypeInfo, Symtab};
+use isla_lib::ir_lexer::new_ir_lexer;
+use isla_lib::ir_parser::IrParser;
+
+#[test]
+fn requires_declared_instrumented_functions() -> Result<(), String> {
+    let mut symbols = Symtab::new();
+    let source = include_str!("../../fixtures/forbidden-calls.ir");
+    let definitions = IrParser::new().parse(&mut symbols, new_ir_lexer(source)).map_err(|error| error.to_string())?;
+    let fault = symbols.get("zfault").ok_or("fixture function is absent")?;
+    let flag = symbols.get("zflag").ok_or("fixture register is absent")?;
+    let types = IRTypeInfo::new(&definitions);
+    let mut state = SharedState::<B64>::new(
+        symbols,
+        &definitions,
+        types,
+        Default::default(),
+        Default::default(),
+        Default::default(),
+        Vec::new(),
+        Vec::new(),
+        Vec::new(),
+    );
+    let names = BTreeSet::from(["fault".to_string()]);
+    assert!(resolve(&names, MemoryProfile::Sequential, &state).is_err());
+    state.trace_functions.insert(fault);
+    assert_eq!(resolve(&names, MemoryProfile::Sequential, &state)?["fault"], fault);
+    assert!(resolve(&names, MemoryProfile::Axiomatic, &state).is_err());
+    state.trace_functions.insert(flag);
+    let register = BTreeSet::from(["flag".to_string()]);
+    assert!(resolve(&register, MemoryProfile::Sequential, &state).is_err());
+    let missing = BTreeSet::from(["missing".to_string()]);
+    assert!(resolve(&missing, MemoryProfile::Sequential, &state).is_err());
+    assert!(resolve(&BTreeSet::new(), MemoryProfile::Axiomatic, &state)?.is_empty());
+    Ok(())
+}
diff --git a/isla-axiomatic/src/forbidden_calls_solver_tests.rs b/isla-axiomatic/src/forbidden_calls_solver_tests.rs
new file mode 100644
index 0000000..22230f9
--- /dev/null
+++ b/isla-axiomatic/src/forbidden_calls_solver_tests.rs
@@ -0,0 +1,42 @@
+// The real solver must retain path feasibility for forbidden-call assertions.
+// An observed call cannot override contradictory path constraints.
+use super::*;
+use std::error::Error;
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+fn solver_output(script: &str) -> Result<String, Box<dyn Error>> {
+    let mut child =
+        Command::new("z3").arg("-in").stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    let mut input = child.stdin.take().ok_or("solver stdin is absent")?;
+    input.write_all(script.as_bytes())?;
+    drop(input);
+    let output = child.wait_with_output()?;
+    if !output.status.success() || !output.stderr.is_empty() {
+        return Err(format!("solver error: {} {}", output.status, String::from_utf8_lossy(&output.stderr)).into());
+    }
+    Ok(String::from_utf8(output.stdout)?)
+}
+
+#[test]
+fn preserves_requirement_and_call_truth_table() -> Result<(), Box<dyn Error>> {
+    let cases = [("false", false, "unsat"), ("true", false, "sat"), ("false", true, "sat"), ("true", true, "sat")];
+    for (requirement, called, expected) in cases {
+        let calls = BTreeMap::from([("fault".to_string(), called)]);
+        let condition = assertion(requirement, &calls);
+        let output = solver_output(&format!("(assert {})\n(check-sat)\n", condition))?;
+        assert_eq!(output.trim(), expected);
+    }
+    assert_eq!(assertion("false", &BTreeMap::new()), "false");
+    Ok(())
+}
+
+#[test]
+fn infeasible_fault_is_not_a_counterexample() -> Result<(), Box<dyn Error>> {
+    let calls = BTreeMap::from([("fault".to_string(), true)]);
+    let condition = assertion("false", &calls);
+    let script =
+        format!("(declare-const path Bool)\n(assert path)\n(assert (not path))\n(assert {})\n(check-sat)\n", condition);
+    assert_eq!(solver_output(&script)?, "unsat\n");
+    Ok(())
+}
