diff --git a/isla-axiomatic/src/sequential_candidate.rs b/isla-axiomatic/src/sequential_candidate.rs
new file mode 100644
index 0000000..ffc2fcb
--- /dev/null
+++ b/isla-axiomatic/src/sequential_candidate.rs
@@ -0,0 +1,45 @@
+// Sequential candidates retain trace constraints without whole-access RF rules.
+// Unsupported candidate requests return errors before solver execution.
+use crate::graph::GraphMode;
+use crate::memory_profile::MemoryProfile;
+use isla_lib::bitvector::BV;
+use isla_lib::ir::{Name, Val};
+use std::collections::HashMap;
+use std::io::Write;
+
+pub(crate) fn validate(
+    profile: MemoryProfile,
+    graph: GraphMode,
+    extra_smt: &[(String, String)],
+    exhaustive: bool,
+) -> Result<(), String> {
+    if profile == MemoryProfile::Axiomatic {
+        return Ok(());
+    }
+    if exhaustive {
+        return Err("Sequential memory does not support read-from enumeration".to_string());
+    }
+    if graph != GraphMode::Disabled {
+        return Err("Sequential candidates do not support CAT graph requests".to_string());
+    }
+    if !extra_smt.is_empty() {
+        return Err("Sequential candidates do not support extra SMT contracts".to_string());
+    }
+    Ok(())
+}
+
+pub(crate) fn write_values<B: BV>(
+    output: &mut dyn Write,
+    final_writes: &HashMap<(Name, usize), &Val<B>>,
+) -> std::io::Result<()> {
+    writeln!(output, "(define-fun sequential-model-present () Bool true)")?;
+    write!(output, "(get-value (sequential-model-present")?;
+    for symbol in crate::final_value::symbols(final_writes.values().copied()) {
+        write!(output, " {}", symbol)?;
+    }
+    writeln!(output, "))")
+}
+
+#[cfg(test)]
+#[path = "sequential_candidate_tests.rs"]
+mod tests;
