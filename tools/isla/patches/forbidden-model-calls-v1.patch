+// State tests distinguish initial bytes, ordinary stores, overlap, and branch copies.
+// Unspecified bytes and the unused primitive Boolean must remain symbolic.
+use super::*;
+
+#[test]
+fn sequential_memory_ordinary_store_ignores_primitive_status() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::from([(0x1000, 0x12), (0x1001, 0x34)]));
+    let address = Val::Bits(B64::from_u64(0x1000));
+    let initial = load(&memory, &mut solver, address.clone(), 2)?;
+    equal(&mut solver, &initial, bits64(0x3412, 16))?;
+    let status = memory.write(
+        Val::Unit,
+        address.clone(),
+        Val::Bits(B64::new(0x7788, 16)),
+        &mut solver,
+        None,
+        WriteOpts::default(),
+    )?;
+    let result = load(&memory, &mut solver, address, 2)?;
+    equal(&mut solver, &result, bits64(0x7788, 16))?;
+    for status_value in [false, true] {
+        let condition = Exp::Eq(Box::new(smt_value(&status, SourceLoc::unknown())?), Box::new(Exp::Bool(status_value)));
+        assert!(matches!(solver.check_sat_with(&condition, SourceLoc::unknown()), SmtResult::Sat));
+    }
+    Ok(())
+}
+
+#[test]
+fn sequential_memory_overlapping_store_replaces_only_its_bytes() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::new());
+    let address = Val::Bits(B64::from_u64(0x1000));
+    store(&mut memory, &mut solver, address.clone(), Val::Bits(B64::new(0x44332211, 32)), true)?;
+    store(&mut memory, &mut solver, Val::Bits(B64::from_u64(0x1001)), Val::Bits(B64::new(0x9988, 16)), true)?;
+    let result = load(&memory, &mut solver, address, 4)?;
+    equal(&mut solver, &result, bits64(0x44998811, 32))
+}
+
+#[test]
+fn sequential_memory_fork_clones_preserve_separate_state() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let original = memory(&mut solver, BTreeMap::from([(0x1000, 0x12)]));
+    let mut branch = original.clone();
+    let address = Val::Bits(B64::from_u64(0x1000));
+    store(&mut branch, &mut solver, address.clone(), Val::Bits(B64::new(0x77, 8)), true)?;
+    let unchanged = load(&original, &mut solver, address.clone(), 1)?;
+    equal(&mut solver, &unchanged, bits64(0x12, 8))?;
+    let changed = load(&branch, &mut solver, address, 1)?;
+    equal(&mut solver, &changed, bits64(0x77, 8))
+}
+
+#[test]
+fn sequential_memory_unspecified_bytes_remain_symbolic() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let memory = memory(&mut solver, BTreeMap::new());
+    let result = load(&memory, &mut solver, Val::Bits(B64::from_u64(0x1000)), 1)?;
+    for value in [0, 0xff] {
+        let equality = Exp::Eq(Box::new(smt_value(&result, SourceLoc::unknown())?), Box::new(bits64(value, 8)));
+        assert!(matches!(solver.check_sat_with(&equality, SourceLoc::unknown()), SmtResult::Sat));
+    }
+    Ok(())
+}
