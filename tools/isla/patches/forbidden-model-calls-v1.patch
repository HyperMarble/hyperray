+// Initialization tests use the public memory API and declared input bytes.
+// Invalid input must not change earlier bytes or region permissions.
+use super::*;
+use crate::bitvector::b64::B64;
+use crate::ir::Val;
+use crate::memory::SmtKind;
+
+#[test]
+fn section_replaces_reservation_without_losing_neighbors() -> Result<(), String> {
+    let mut memory = Memory::<B64>::new();
+    memory.add_concrete_region(0x1000..0x2000, [(0x1010, 0x77), (0x1030, 0x88)].into_iter().collect());
+    memory.initialize_section(0x1020, &[0x12, 0x34], true)?;
+    assert_eq!(memory.regions().len(), 3);
+    assert_eq!(memory.region_name_at(0x1020), "symbolic");
+    assert!(memory.access_check(0x1020, 2, SmtKind::WriteData));
+    assert!(!memory.access_check(0x1010, 1, SmtKind::WriteData));
+    assert!(matches!(memory.read_initial(0x1020, 2), Ok(Val::Bits(bits)) if bits.lower_u64() == 0x3412));
+    assert!(matches!(memory.read_initial(0x1010, 1), Ok(Val::Bits(bits)) if bits.lower_u64() == 0x77));
+    assert!(matches!(memory.read_initial(0x1030, 1), Ok(Val::Bits(bits)) if bits.lower_u64() == 0x88));
+    Ok(())
+}
+
+#[test]
+fn invalid_sections_leave_memory_unchanged() -> Result<(), String> {
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &[0x12, 0x34], false)?;
+    let before = format!("{:?}", memory);
+    for (address, bytes) in [(0x1001, vec![1]), (u64::MAX, vec![1]), (0, vec![])] {
+        assert!(memory.initialize_section(address, &bytes, true).is_err());
+        assert_eq!(format!("{:?}", memory), before);
+    }
+    memory.add_symbolic_region(0x2000..0x3000);
+    let before = format!("{:?}", memory);
+    assert!(memory.initialize_section(0x2001, &[1], true).is_err());
+    assert_eq!(format!("{:?}", memory), before);
+    Ok(())
+}
+
+#[test]
+fn adjacent_sections_share_initial_bytes() -> Result<(), String> {
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &[0x12, 0x34], false)?;
+    memory.initialize_section(0x1002, &[0x56, 0x78], true)?;
+    assert_eq!(memory.initialized_bytes().len(), 4);
+    assert!(matches!(memory.read_initial(0x1001, 2), Ok(Val::Bits(bits)) if bits.lower_u64() == 0x5634));
+    assert!(!memory.access_check(0x1000, 1, SmtKind::WriteData));
+    assert!(memory.access_check(0x1002, 1, SmtKind::WriteData));
+    Ok(())
+}
