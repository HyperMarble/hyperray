+// Public memory reads return concrete values only after uniqueness proof.
+// Stored contents and later mutations must determine each read independently.
+use super::*;
+
+#[test]
+fn stored_pointer_reads_become_concrete() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::new());
+    let address = Val::Bits(B64::from_u64(0x1000));
+    for pointer in [0x2000, 0x3000] {
+        let value = B64::from_u64(pointer);
+        store(&mut memory, &mut solver, address.clone(), Val::Bits(value), true)?;
+        let result = load(&memory, &mut solver, address.clone(), 8)?;
+        assert!(matches!(result, Val::Bits(bits) if bits == value));
+    }
+    Ok(())
+}
+
+#[test]
+fn symbolic_store_retains_each_feasible_value() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::new());
+    let address = Val::Bits(B64::from_u64(0x1000));
+    let value = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+    store(&mut memory, &mut solver, address.clone(), Val::Symbolic(value), true)?;
+    let result = load(&memory, &mut solver, address, 8)?;
+    assert!(matches!(result, Val::Symbolic(_)));
+    equal(&mut solver, &result, Exp::Var(value))?;
+    for alternative in [0, u64::MAX] {
+        let condition = Exp::Eq(Box::new(Exp::Var(value)), Box::new(bits64(alternative, 64)));
+        assert!(solver.check_sat_with(&condition, SourceLoc::unknown()).is_sat()?);
+    }
+    Ok(())
+}
+
+#[test]
+fn inconsistent_memory_read_returns_an_error() {
