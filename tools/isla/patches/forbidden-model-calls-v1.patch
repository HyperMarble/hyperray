+// Solver-backed uniqueness tests retain alternatives and reject vacuous models.
+// Successful solver sampling alone is not a uniqueness assertion.
+use super::*;
+use crate::smt::smtlib::{bits64, Ty};
+use crate::smt::{Config, Context, SmtResult};
+
+#[test]
+fn unique_bitvector_preserves_declared_values() -> Result<(), ExecError> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::<B64>::new(&context);
+    for value in [0, u64::MAX] {
+        let symbol = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+        solver.assert_eq(Exp::Var(symbol), bits64(value, 64));
+        assert_eq!(bitvector(&mut solver, symbol)?, Some(B64::from_u64(value)));
+        assert!(solver.check_sat(SourceLoc::unknown()).is_sat()?);
+    }
+    Ok(())
+}
+
+#[test]
+fn multiple_values_remain_possible() -> Result<(), ExecError> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::<B64>::new(&context);
+    let symbol = solver.declare_const(Ty::BitVec(8), SourceLoc::unknown());
+    let first = Exp::Eq(Box::new(Exp::Var(symbol)), Box::new(bits64(0, 8)));
+    let second = Exp::Eq(Box::new(Exp::Var(symbol)), Box::new(bits64(1, 8)));
+    solver.assert(Exp::Or(Box::new(first.clone()), Box::new(second.clone())));
+    assert_eq!(bitvector(&mut solver, symbol)?, None);
+    assert!(solver.check_sat_with(&first, SourceLoc::unknown()).is_sat()?);
+    assert!(solver.check_sat_with(&second, SourceLoc::unknown()).is_sat()?);
+    Ok(())
+}
+
+#[test]
+fn unconstrained_and_wide_values_remain_symbolic() -> Result<(), ExecError> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::<B64>::new(&context);
+    for width in [8, 64, 128] {
+        let symbol = solver.declare_const(Ty::BitVec(width), SourceLoc::unknown());
+        assert_eq!(bitvector(&mut solver, symbol)?, None);
+    }
+    Ok(())
+}
+
+#[test]
+fn inconsistent_constraints_cannot_prove_uniqueness() {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::<B64>::new(&context);
+    let symbol = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+    solver.assert(Exp::Bool(false));
+    assert!(matches!(bitvector(&mut solver, symbol), Err(ExecError::NoModel)));
+}
+
+#[test]
+fn unsupported_type_and_unknown_result_are_errors() {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::<B64>::new(&context);
+    let symbol = solver.declare_const(Ty::Bool, SourceLoc::unknown());
+    assert!(matches!(bitvector(&mut solver, symbol), Err(ExecError::Type(_, _))));
+    assert!(matches!(SmtResult::Unknown.is_sat(), Err(ExecError::Z3Unknown)));
+    assert!(matches!(SmtResult::Unknown.is_unsat(), Err(ExecError::Z3Unknown)));
+}
