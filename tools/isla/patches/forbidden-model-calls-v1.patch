new file mode 100644
index 0000000..cbbcea9
--- /dev/null
+++ b/isla-axiomatic/src/initial_state_type.rs
@@ -0,0 +1,32 @@
+// Initial values must match the existing model type declarations exactly.
+// Aggregate values cannot bypass checks of their fields or elements.
+use isla_lib::bitvector::BV;
+use isla_lib::ir::{IRTypeInfo, Name, Ty, Val};
+
+pub(crate) fn matches<B: BV>(value: &Val<B>, ty: &Ty<Name>, types: &IRTypeInfo) -> bool {
+    match (value, ty) {
+        (Val::I64(_), Ty::I64) | (Val::I128(_), Ty::I128) => true,
+        (Val::Bool(_), Ty::Bool) | (Val::Unit, Ty::Unit) => true,
+        (Val::String(_), Ty::String) | (Val::Bits(_), Ty::AnyBits) => true,
+        (Val::Bits(bits), Ty::Bits(width)) => bits.len() == *width,
+        (Val::Bits(bits), Ty::Bit) => bits.len() == 1,
+        (Val::Struct(values), Ty::Struct(name)) => {
+            let Some(fields) = types.structs.get(name) else {
+                return false;
+            };
+            fields.len() == values.len()
+                && fields.iter().all(|(field, ty)| values.get(field).is_some_and(|value| matches(value, ty, types)))
+        }
+        (Val::Enum(member), Ty::Enum(name)) => {
+            member.enum_id.to_name() == *name
+                && types.enums.get(name).is_some_and(|members| member.member < members.len())
+        }
+        (Val::Vector(values), Ty::FixedVector(length, element)) => {
+            values.len() == *length as usize && values.iter().all(|value| matches(value, element, types))
+        }
+        (Val::Vector(values), Ty::Vector(element)) | (Val::List(values), Ty::List(element)) => {
+            values.iter().all(|value| matches(value, element, types))
+        }
+        _ => false,
+    }
+}
