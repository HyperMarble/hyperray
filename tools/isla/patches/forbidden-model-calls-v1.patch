@@ -0,0 +1,40 @@
+// Call observations belong to one candidate and exclude return events.
+// Malformed requirement data must not become an empty safety condition.
+use super::*;
+use isla_lib::bitvector::b64::B64;
+
+#[path = "forbidden_calls_resolution_tests.rs"]
+mod resolution;
+#[path = "forbidden_calls_solver_tests.rs"]
+mod solver;
+
+#[test]
+fn rejects_malformed_call_requirements() -> Result<(), String> {
+    for source in [
+        "forbidden_model_calls = true",
+        "forbidden_model_calls = [true]",
+        "forbidden_model_calls = [\"\"]",
+        "forbidden_model_calls = [\"fault\", \"fault\"]",
+    ] {
+        let input = toml::from_str(source).map_err(|error| error.to_string())?;
+        assert!(parse(&input).is_err());
+    }
+    let input = toml::from_str("").map_err(|error| error.to_string())?;
+    assert!(parse(&input)?.is_empty());
+    let input = toml::from_str("forbidden_model_calls = [\"fault\"]").map_err(|error| error.to_string())?;
+    assert_eq!(parse(&input)?, BTreeSet::from(["fault".to_string()]));
+    Ok(())
+}
+
+#[test]
+fn observations_are_candidate_local() {
+    let fault = Name::from_u32(1);
+    let unrelated = Name::from_u32(2);
+    let functions = BTreeMap::from([("fault".to_string(), fault)]);
+    let called = [Event::<B64>::Function { name: fault, call: true }];
+    let returned = [Event::<B64>::Function { name: fault, call: false }];
+    let other = [Event::<B64>::Function { name: unrelated, call: true }];
+    assert!(observations(&functions, &[&called])["fault"]);
+    assert!(!observations(&functions, &[&returned, &other])["fault"]);
+    assert!(!observations::<B64>(&functions, &[])["fault"]);
+}
