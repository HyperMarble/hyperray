+// Profile parsing must preserve explicit semantics and reject malformed choices.
+// Absence alone retains the original axiomatic route.
+use super::MemoryProfile;
+use toml::Value;
+
+#[test]
+fn profile_selection_is_explicit() -> Result<(), String> {
+    let absent: Value = toml::from_str("").map_err(|error| error.to_string())?;
+    assert_eq!(MemoryProfile::parse(&absent)?, MemoryProfile::Axiomatic);
+    let sequential: Value = toml::from_str("memory_profile = 'sequential'").map_err(|error| error.to_string())?;
+    assert_eq!(MemoryProfile::parse(&sequential)?, MemoryProfile::Sequential);
+    for source in ["memory_profile = true", "memory_profile = ''", "memory_profile = 'unknown'"] {
+        let value: Value = toml::from_str(source).map_err(|error| error.to_string())?;
+        assert!(MemoryProfile::parse(&value).is_err());
+    }
+    Ok(())
+}
