@@ -0,0 +1,59 @@
+// Native solver tests use the production assertion and witness emitters.
+// Mixed-width byte overlap must retain a satisfiable execution.
+use super::*;
+use isla_lib::smt::Sym;
+use std::error::Error;
+use std::process::{Command, Stdio};
+
+fn operate(script: &[u8]) -> Result<String, Box<dyn Error>> {
+    let mut child =
+        Command::new("z3").arg("-in").stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    let mut input = child.stdin.take().ok_or("solver stdin is absent")?;
+    input.write_all(script)?;
+    drop(input);
+    let result = child.wait_with_output()?;
+    if !result.status.success() || !result.stderr.is_empty() {
+        return Err(format!("solver error: {} {}", result.status, String::from_utf8_lossy(&result.stderr)).into());
+    }
+    Ok(String::from_utf8(result.stdout)?)
+}
+
+#[test]
+fn mixed_width_result_and_mutation() -> Result<(), Box<dyn Error>> {
+    let register = Name::from_u32(1);
+    let value = Val::<B64>::Symbolic(Sym::from_u32(7));
+    let writes = HashMap::from([((register, 0), &value)]);
+    let location = Loc::Register { reg: register, thread_id: 0 };
+    let assertion = Exp::EqLoc(location, Box::new(Exp::Nat(0x2211)));
+    let correct = crate::smt_events::sequential_assertion(&assertion, &writes)?;
+    let incorrect = crate::smt_events::sequential_assertion(&Exp::Not(Box::new(assertion)), &writes)?;
+    let mut script = br#"(set-option :produce-models true)
+(declare-const initial (Array (_ BitVec 64) (_ BitVec 8)))
+(define-fun first () (Array (_ BitVec 64) (_ BitVec 8)) (store initial #x0000000000001000 #x11))
+(define-fun second () (Array (_ BitVec 64) (_ BitVec 8)) (store first #x0000000000001001 #x22))
+(define-fun v7 () (_ BitVec 64) ((_ zero_extend 48) (concat (select second #x0000000000001001) (select second #x0000000000001000))))
+"#.to_vec();
+    writeln!(script, "(push)\n(assert {})\n(check-sat)", correct)?;
+    write_values(&mut script, &writes)?;
+    writeln!(script, "(pop)\n(assert {})\n(check-sat)", incorrect)?;
+    let result = operate(&script)?;
+    assert!(result.starts_with("sat\n"), "{}", result);
+    assert!(result.contains("(v7 #x0000000000002211)"), "{}", result);
+    assert!(result.ends_with("unsat\n"), "{}", result);
+    let model_text = result.strip_prefix("sat\n").ok_or("missing satisfiable result")?;
+    let model_text = model_text.strip_suffix("unsat\n").ok_or("missing unsatisfiable result")?;
+    let mut model = crate::smt_model::Model::<B64>::parse(&[], model_text).map_err(|error| error.to_string())?;
+    let concrete = crate::final_value::concrete(value, &mut model)?;
+    assert_eq!(concrete, Val::Bits(B64::from_u64(0x2211)));
+    Ok(())
+}
+
+#[test]
+fn constant_final_values_need_no_cat_symbols() -> Result<(), Box<dyn Error>> {
+    let writes = HashMap::<(Name, usize), &Val<B64>>::new();
+    let mut script = b"(check-sat)\n".to_vec();
+    write_values(&mut script, &writes)?;
+    let result = operate(&script)?;
+    assert_eq!(result, "sat\n((sequential-model-present true))\n");
+    Ok(())
+}
