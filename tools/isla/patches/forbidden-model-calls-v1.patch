@@ -0,0 +1,69 @@
+// Model-call requirements reuse traced calls and retain candidate constraints.
+// Missing model functions or instrumentation must never imply safety.
+use crate::memory_profile::MemoryProfile;
+use isla_lib::bitvector::BV;
+use isla_lib::ir::{Name, SharedState};
+use isla_lib::smt::Event;
+use isla_lib::zencode;
+use std::collections::{BTreeMap, BTreeSet};
+use toml::Value;
+
+pub(crate) fn parse(input: &Value) -> Result<BTreeSet<String>, String> {
+    let Some(value) = input.get("forbidden_model_calls") else {
+        return Ok(BTreeSet::new());
+    };
+    let array = value.as_array().ok_or("Forbidden model calls must be an array")?;
+    let mut names = BTreeSet::new();
+    for value in array {
+        let name = value.as_str().ok_or("Forbidden model calls must contain strings")?;
+        if name.is_empty() || !names.insert(name.to_string()) {
+            return Err("Forbidden model calls contain an empty or duplicate name".to_string());
+        }
+    }
+    Ok(names)
+}
+
+pub(crate) fn resolve<B: BV>(
+    names: &BTreeSet<String>,
+    profile: MemoryProfile,
+    state: &SharedState<B>,
+) -> Result<BTreeMap<String, Name>, String> {
+    if !names.is_empty() && profile != MemoryProfile::Sequential {
+        return Err("Forbidden model calls require sequential memory".to_string());
+    }
+    let mut resolved = BTreeMap::new();
+    for name in names {
+        let id = state.symtab.get(&zencode::encode(name)).ok_or_else(|| format!("Unknown model function: {}", name))?;
+        if !state.functions.contains_key(&id) || !state.trace_functions.contains(&id) {
+            return Err(format!("Forbidden model call requires an instrumented function: {}", name));
+        }
+        resolved.insert(name.clone(), id);
+    }
+    Ok(resolved)
+}
+
+pub(crate) fn observations<B: BV>(
+    functions: &BTreeMap<String, Name>,
+    threads: &[&[Event<B>]],
+) -> BTreeMap<String, bool> {
+    let calls: BTreeSet<Name> = threads
+        .iter()
+        .flat_map(|thread| thread.iter())
+        .filter_map(|event| match event {
+            Event::Function { name, call: true } => Some(*name),
+            _ => None,
+        })
+        .collect();
+    functions.iter().map(|(name, id)| (name.clone(), calls.contains(id))).collect()
+}
+
+pub(crate) fn assertion(final_assertion: &str, calls: &BTreeMap<String, bool>) -> String {
+    if calls.is_empty() {
+        return final_assertion.to_string();
+    }
+    format!("(or {} {})", final_assertion, calls.values().any(|called| *called))
+}
+
+#[cfg(test)]
+#[path = "forbidden_calls_tests.rs"]
+mod tests;
diff --git a/isla-axiomatic/src/forbidden_calls_resolution_tests.rs b/isla-axiomatic/src/forbidden_calls_resolution_tests.rs
