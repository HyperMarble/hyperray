@@ -0,0 +1,54 @@
+// Writable data remains a symbolic event after initialization and stores.
+// These tests must not introduce sequential forwarding into the memory model.
+use super::*;
+use crate::bitvector::b64::B64;
+use crate::ir::Val;
+use crate::smt::smtlib::{bits64, Exp, Ty};
+use crate::smt::{Config, Context, Event, ReadOpts, SmtResult, Solver, WriteOpts};
+use crate::source_loc::SourceLoc;
+
+#[test]
+fn writable_reads_preserve_symbolic_values() -> Result<(), String> {
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &[0x12, 0x34], true)?;
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let address = Val::Bits(B64::from_u64(0x1000));
+    memory
+        .write(Val::Unit, address.clone(), Val::Bits(B64::new(0x77, 8)), &mut solver, None, WriteOpts::default())
+        .map_err(|error| format!("{:?}", error))?;
+    let read = memory
+        .read(Val::Unit, address, Val::I128(1), &mut solver, false, ReadOpts::default())
+        .map_err(|error| format!("{:?}", error))?;
+    let Val::Symbolic(value) = read else {
+        return Err("writable read returned a constant".to_string());
+    };
+    for alternative in [0x12, 0x77] {
+        let equality = Exp::Eq(Box::new(Exp::Var(value)), Box::new(bits64(alternative, 8)));
+        assert!(matches!(solver.check_sat_with(&equality, SourceLoc::unknown()), SmtResult::Sat));
+    }
+    let events = solver.trace().to_vec();
+    assert_eq!(events.iter().filter(|event| matches!(event, Event::WriteMem { .. })).count(), 1);
+    assert_eq!(events.iter().filter(|event| matches!(event, Event::ReadMem { .. })).count(), 1);
+    Ok(())
+}
+
+#[test]
+fn symbolic_addresses_can_select_writable_bytes() -> Result<(), String> {
+    let mut memory = Memory::<B64>::new();
+    memory.add_zero_region(0..0x2000);
+    memory.initialize_section(0x1000, &[0x12, 0x34], true)?;
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let address = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+    solver.assert(Exp::Or(
+        Box::new(Exp::Eq(Box::new(Exp::Var(address)), Box::new(bits64(0x1000, 64)))),
+        Box::new(Exp::Eq(Box::new(Exp::Var(address)), Box::new(bits64(0x1001, 64)))),
+    ));
+    let value = memory
+        .read(Val::Unit, Val::Symbolic(address), Val::I128(1), &mut solver, false, ReadOpts::default())
+        .map_err(|error| format!("{:?}", error))?;
+    assert!(matches!(value, Val::Symbolic(_)));
+    assert!(matches!(solver.check_sat(SourceLoc::unknown()), SmtResult::Sat));
+    Ok(())
+}
diff --git a/isla-lib/src/initialized_memory/regions.rs b/isla-lib/src/initialized_memory/regions.rs
new file mode 100644
index 0000000..36fb056
--- /dev/null
+++ b/isla-lib/src/initialized_memory/regions.rs
@@ -0,0 +1,23 @@
+// A loaded section replaces concrete reservation bytes only.
+// Existing symbolic or custom behavior must not disappear.
+use super::{Address, Region};
+use std::ops::Range;
+
+pub(super) fn outside<B>(region: &Region<B>, section: &Range<Address>) -> Result<Vec<Region<B>>, String> {
+    let range = region.region_range();
+    if range.end <= section.start || section.end <= range.start {
+        return Ok(vec![region.clone()]);
+    }
+    let Region::Concrete(range, contents) = region else {
+        return Err("initialized section overlaps a non-concrete region".to_string());
+    };
+    let mut remaining = Vec::new();
+    for remainder in [range.start..section.start, section.end..range.end] {
+        if remainder.start < remainder.end {
+            let bytes = contents.iter().filter(|(address, _)| remainder.contains(address));
+            let bytes = bytes.map(|(address, byte)| (*address, *byte)).collect();
+            remaining.push(Region::Concrete(remainder, bytes));
+        }
+    }
+    Ok(remaining)
+}
