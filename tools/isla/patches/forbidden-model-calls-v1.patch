@@ -0,0 +1,44 @@
+// Initial read and final-memory expressions share the loaded byte image.
+// This layer must not replace read-from or ordering constraints.
+use isla_cat::smt::Sexp;
+use isla_lib::bitvector::BV;
+use isla_lib::ir::Val;
+use isla_lib::memory::Memory;
+use std::io::Write;
+use std::num::NonZeroU32;
+
+#[cfg(test)]
+mod tests;
+
+pub(super) fn definition<B: BV>(output: &mut dyn Write, memory: &Memory<B>) -> std::io::Result<()> {
+    write!(output, "(define-fun loaded-initial-byte ((address (_ BitVec 64))) (_ BitVec 8) ")?;
+    for (address, byte) in memory.initialized_bytes() {
+        write!(output, "(ite (= address #x{:016x}) #x{:02x} ", address, byte)?;
+    }
+    write!(output, "#x00")?;
+    write!(output, "{}", ")".repeat(memory.initialized_bytes().len()))?;
+    writeln!(output, ")")
+}
+
+pub(super) fn value(address: &str, bytes: NonZeroU32) -> String {
+    let mut result = format!("(loaded-initial-byte {})", address);
+    for offset in 1..bytes.get() {
+        let part = format!("(loaded-initial-byte (bvadd {} #x{:016x}))", address, offset);
+        result = format!("(concat {} {})", part, result);
+    }
+    result
+}
+
+pub(super) fn condition<B: BV>(read: &Val<B>, address: &Val<B>, bytes: u32, memory: &Memory<B>) -> Option<Sexp> {
+    if memory.initialized_bytes().is_empty() || bytes == 0 {
+        return None;
+    }
+    if let Val::Bits(address) = address {
+        if memory.in_custom_region(address.lower_u64()).is_some() {
+            return None;
+        }
+    }
+    let address = super::smt_bitvec(address);
+    let read = super::smt_bitvec(read);
+    Some(Sexp::Literal(format!("(= {} {})", read, value(&address, NonZeroU32::new(bytes)?))))
+}
