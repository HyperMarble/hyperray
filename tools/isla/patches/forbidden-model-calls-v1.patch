index 0000000..3f13eb1
--- /dev/null
+++ b/isla-lib/src/sequential_memory/callbacks.rs
@@ -0,0 +1,70 @@
+// Callback errors remain public memory errors before event publication.
+// No unsupported metadata can become an array-only proof.
+use super::{read, validate, write, SequentialMemory};
+use crate::bitvector::BV;
+use crate::error::ExecError;
+use crate::ir::Val;
+use crate::memory::{MemoryCallbacks, Region};
+use crate::smt::{ReadOpts, Solver, Sym, WriteOpts};
+
+#[allow(clippy::too_many_arguments)]
+impl<B: BV> MemoryCallbacks<B> for SequentialMemory {
+    fn resolve_read(&self, solver: &mut Solver<B>, value: Sym) -> Result<Option<B>, ExecError> {
+        crate::unique_value::bitvector(solver, value)
+    }
+
+    fn validate_read(&self, opts: &ReadOpts, tagged: bool) -> Result<(), ExecError> {
+        validate::access(opts.is_exclusive, tagged)
+    }
+
+    fn validate_write(&self, opts: &WriteOpts, tagged: bool) -> Result<(), ExecError> {
+        validate::access(opts.is_exclusive(), tagged)
+    }
+
+    fn symbolic_read(
+        &self,
+        _regions: &[Region<B>],
+        solver: &mut Solver<B>,
+        value: &Val<B>,
+        _read_kind: &Val<B>,
+        address: &Val<B>,
+        bytes: u32,
+        tag: &Option<Val<B>>,
+        opts: &ReadOpts,
+    ) -> Result<(), ExecError> {
+        validate::access(opts.is_exclusive, tag.is_some())?;
+        if opts.is_ifetch {
+            return Err(ExecError::BadRead("Sequential memory does not support symbolic instruction fetch"));
+        }
+        read::constrain(self.memory, solver, value, address, bytes)
+    }
+
+    fn symbolic_write(
+        &mut self,
+        _regions: &[Region<B>],
+        solver: &mut Solver<B>,
+        _primitive_status: Sym,
+        _write_kind: &Val<B>,
+        address: &Val<B>,
+        data: &Val<B>,
+        bytes: u32,
+        tag: &Option<Val<B>>,
+        opts: &WriteOpts,
+    ) -> Result<(), ExecError> {
+        validate::access(opts.is_exclusive(), tag.is_some())?;
+        self.memory = write::update(self.memory, solver, address, data, bytes)?;
+        Ok(())
+    }
+
+    fn symbolic_write_tag(
+        &mut self,
+        _regions: &[Region<B>],
+        _solver: &mut Solver<B>,
+        _value: Sym,
+        _write_kind: &Val<B>,
+        _address: &Val<B>,
+        _tag: &Val<B>,
+    ) -> Result<(), ExecError> {
+        Err(ExecError::BadWrite("Sequential memory does not support memory tags"))
+    }
+}
