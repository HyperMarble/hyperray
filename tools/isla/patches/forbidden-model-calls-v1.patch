@@ -0,0 +1,37 @@
+// Final register values come from the solver model, never symbolic identifiers.
+// Unsupported model values remain explicit output errors.
+
+use crate::sexp::SexpVal;
+use crate::smt_model::Model;
+use isla_lib::bitvector::BV;
+use isla_lib::ir::Val;
+use std::collections::BTreeSet;
+
+#[cfg(test)]
+#[path = "final_value_tests.rs"]
+mod tests;
+
+pub(crate) fn symbols<'a, B: BV>(values: impl Iterator<Item = &'a Val<B>>) -> BTreeSet<String> {
+    let mut symbols = BTreeSet::new();
+    for value in values {
+        if let Val::Symbolic(symbol) = value {
+            symbols.insert(format!("v{}", symbol));
+        }
+    }
+    symbols
+}
+
+pub(crate) fn concrete<B: BV>(value: Val<B>, model: &mut Model<'_, '_, B>) -> Result<Val<B>, String> {
+    let symbol = match value {
+        Val::Symbolic(symbol) => symbol,
+        Val::Bits(_) | Val::Bool(_) | Val::I64(_) | Val::I128(_) => return Ok(value),
+        _ => return Err("final register is not a scalar model value".to_string()),
+    };
+    let result = model.interpret(&format!("v{}", symbol), &[]).map_err(|error| error.to_string())?;
+    match result {
+        SexpVal::Bits(bits) => Ok(Val::Bits(bits)),
+        SexpVal::Bool(value) => Ok(Val::Bool(value)),
+        SexpVal::I128(value) => Ok(Val::I128(value)),
+        SexpVal::Event(_) | SexpVal::Relation(_) => Err("final register model value is not a scalar".to_string()),
+    }
+}
