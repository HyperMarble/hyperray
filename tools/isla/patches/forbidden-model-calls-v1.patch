@@ -0,0 +1,49 @@
+// Stored pointers constrain later addresses through the same generic array.
+// No address restriction or pointer constant can stand in for this identity.
+use super::*;
+
+#[test]
+fn sequential_memory_symbolic_pointer_roundtrip() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::new());
+    let address = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+    let pointer = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+    store(&mut memory, &mut solver, Val::Symbolic(address), Val::Symbolic(pointer), true)?;
+    let result = load(&memory, &mut solver, Val::Symbolic(address), 8)?;
+    equal(&mut solver, &result, Exp::Var(pointer))?;
+    for location in [0, u64::MAX] {
+        let equality = Exp::Eq(Box::new(Exp::Var(address)), Box::new(bits64(location, 64)));
+        assert!(matches!(solver.check_sat_with(&equality, SourceLoc::unknown()), SmtResult::Sat));
+    }
+    Ok(())
+}
+
+#[test]
+fn sequential_memory_read_pointer_selects_the_stored_object() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::new());
+    let slot = Val::Bits(B64::from_u64(0x1000));
+    let target = Val::Bits(B64::from_u64(0x2000));
+    store(&mut memory, &mut solver, slot.clone(), target.clone(), true)?;
+    store(&mut memory, &mut solver, target, Val::Bits(B64::from_u64(0x1234)), true)?;
+    let pointer = load(&memory, &mut solver, slot, 8)?;
+    let result = load(&memory, &mut solver, pointer, 8)?;
+    equal(&mut solver, &result, bits64(0x1234, 64))
+}
+
+#[test]
+fn sequential_memory_wide_symbolic_values_roundtrip() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::new());
+    let address = Val::Bits(B64::from_u64(0x1000));
+    for bytes in [1, 2, 3, 4, 8, 16, 32] {
+        let data = solver.declare_const(Ty::BitVec(bytes * 8), SourceLoc::unknown());
+        store(&mut memory, &mut solver, address.clone(), Val::Symbolic(data), true)?;
+        let result = load(&memory, &mut solver, address.clone(), bytes)?;
+        equal(&mut solver, &result, Exp::Var(data))?;
+    }
+    Ok(())
+}
