+// Read resolution must retain symbolic evidence and the default memory behavior.
+// A concrete execution value must not remove the constraint from replay.
+use super::*;
+use crate::smt::{checkpoint, Event};
+
+#[test]
+fn concrete_read_retains_replayable_symbolic_evidence() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::new());
+    let address = Val::Bits(B64::from_u64(0x1000));
+    let value = B64::from_u64(0x2000);
+    store(&mut memory, &mut solver, address.clone(), Val::Bits(value), true)?;
+    let result = load(&memory, &mut solver, address, 8)?;
+    assert!(matches!(result, Val::Bits(bits) if bits == value));
+    let event_value = solver.trace().to_vec().into_iter().find_map(|event| match event {
+        Event::ReadMem { value, .. } => Some(value.clone()),
+        _ => None,
+    });
+    let event_value = event_value.ok_or("Resolved read has no memory event")?;
+    assert!(matches!(event_value, Val::Symbolic(_)));
+    let saved = checkpoint(&mut solver);
+    let mut replay = Solver::from_checkpoint(&context, saved);
+    equal(&mut replay, &event_value, bits64(0x2000, 64))
+}
+
+#[test]
+fn default_memory_read_retains_symbolic_representation() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::<B64>::new(&context);
+    let mut memory = Memory::new();
+    let address = Val::Bits(B64::from_u64(0x1000));
+    store(&mut memory, &mut solver, address.clone(), Val::Bits(B64::from_u64(0x2000)), true)?;
+    let result = load(&memory, &mut solver, address, 8)?;
+    assert!(matches!(result, Val::Symbolic(_)));
+    for value in [0, u64::MAX] {
+        let condition = Exp::Eq(Box::new(smt_value(&result, SourceLoc::unknown())?), Box::new(bits64(value, 64)));
+        assert!(solver.check_sat_with(&condition, SourceLoc::unknown()).is_sat()?);
+    }
+    Ok(())
+}
