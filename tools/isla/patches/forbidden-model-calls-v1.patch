new file mode 100644
index 0000000..6199b80
--- /dev/null
+++ b/isla-axiomatic/src/sequential_candidate_assertion.rs
@@ -0,0 +1,44 @@
+// Assertion validation protects the reused upstream expression translator.
+// Memory assertions and missing or unsupported registers remain explicit errors.
+use crate::litmus::exp::{Exp, Loc};
+use isla_lib::bitvector::BV;
+use isla_lib::ir::{Name, Val};
+use std::collections::HashMap;
+
+pub(crate) fn validate<B: BV>(expression: &Exp<u64>, writes: &HashMap<(Name, usize), &Val<B>>) -> Result<(), String> {
+    let mut pending = vec![expression];
+    while let Some(expression) = pending.pop() {
+        match expression {
+            Exp::EqLoc(location, value) => {
+                validate_location(location, writes)?;
+                pending.push(value);
+            }
+            Exp::App(_, _, keywords) if !keywords.is_empty() => {
+                return Err("Sequential final assertion contains unresolved keyword arguments".to_string())
+            }
+            Exp::And(values) | Exp::Or(values) | Exp::App(_, values, _) => pending.extend(values),
+            Exp::Not(value) => pending.push(value),
+            Exp::Implies(left, right) => {
+                pending.push(left);
+                pending.push(right);
+            }
+            Exp::Label(_) => return Err("Sequential final assertion contains an unresolved label".to_string()),
+            Exp::Loc(_) | Exp::True | Exp::False | Exp::Bin(_) | Exp::Hex(_) | Exp::Bits64(_, _) | Exp::Nat(_) => (),
+        }
+    }
+    Ok(())
+}
+
+fn validate_location<B: BV>(location: &Loc<u64>, writes: &HashMap<(Name, usize), &Val<B>>) -> Result<(), String> {
+    let (reg, thread_id) = match location {
+        Loc::Register { reg, thread_id } => (*reg, *thread_id),
+        Loc::LastWriteTo { .. } => {
+            return Err("Sequential final-memory assertions require separate support".to_string())
+        }
+    };
+    match writes.get(&(reg, thread_id)) {
+        Some(Val::Bits(_)) | Some(Val::Symbolic(_)) => Ok(()),
+        Some(_) => Err("Sequential final register is not a bitvector".to_string()),
+        None => Err("Sequential final register has no recorded value".to_string()),
+    }
+}
