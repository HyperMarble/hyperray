--- /dev/null
+++ b/src/candidate_state.rs
@@ -0,0 +1,25 @@
+// Candidate state keeps model-call observations with the solver-selected state.
+// An unaccepted trace must not supply a concrete witness.
+use isla_axiomatic::litmus::exp::Loc;
+use isla_lib::bitvector::b129::B129;
+use isla_lib::ir::{SharedState, Val};
+use std::collections::{BTreeMap, HashMap};
+use std::io::Write;
+
+#[derive(Debug)]
+pub(crate) struct FinalState {
+    pub registers: HashMap<Loc<String>, Val<B129>>,
+    pub calls: BTreeMap<String, bool>,
+}
+
+impl FinalState {
+    pub fn write(&self, output: &mut dyn Write, state: &SharedState<B129>) -> std::io::Result<()> {
+        for (location, value) in &self.registers {
+            write!(output, "{}={};", location.display(&state.symtab), value.to_string(state))?;
+        }
+        for (name, called) in &self.calls {
+            write!(output, "called:{}={};", name, called)?;
+        }
+        writeln!(output)
+    }
+}
