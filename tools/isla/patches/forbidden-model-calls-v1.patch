@@ -0,0 +1,45 @@
+// Loaded sections preserve their initial bytes and access mode.
+// Invalid or overlapping sections must leave memory unchanged.
+use super::{Address, Memory, Region};
+use crate::bitvector::BV;
+use std::collections::{BTreeMap, HashMap};
+
+#[cfg(test)]
+mod boundary_tests;
+mod loaded_read;
+mod loaded_write;
+#[cfg(test)]
+mod read_tests;
+mod regions;
+#[cfg(test)]
+mod tests;
+#[cfg(test)]
+mod write_tests;
+
+impl<B: BV> Memory<B> {
+    pub fn initialize_section(&mut self, address: Address, bytes: &[u8], writable: bool) -> Result<(), String> {
+        let length = u64::try_from(bytes.len()).map_err(|error| error.to_string())?;
+        if length == 0 {
+            return Err("initialized section is empty".to_string());
+        }
+        let end = address.checked_add(length).ok_or("initialized section address overflow")?;
+        let range = address..end;
+        if self.initial_bytes.range(range.clone()).next().is_some() {
+            return Err("initialized sections overlap".to_string());
+        }
+        let mut remaining = Vec::new();
+        for region in &self.regions {
+            remaining.extend(regions::outside(region, &range)?);
+        }
+        let contents: HashMap<Address, u8> = range.clone().zip(bytes.iter().copied()).collect();
+        let section = if writable { Region::Symbolic(range) } else { Region::Concrete(range, contents.clone()) };
+        remaining.push(section);
+        self.regions = remaining;
+        self.initial_bytes.extend(contents);
+        Ok(())
+    }
+
+    pub fn initialized_bytes(&self) -> &BTreeMap<Address, u8> {
+        &self.initial_bytes
+    }
+}
