@@ -0,0 +1,57 @@
+// Public memory operations provide solver evidence for the byte-array backend.
+// Every equality needs a satisfiable model before a rejected mutation.
+use super::SequentialMemory;
+use crate::bitvector::b64::B64;
+use crate::bitvector::BV;
+use crate::ir::Val;
+use crate::memory::Memory;
+use crate::primop_util::smt_value;
+use crate::smt::smtlib::{bits64, Exp, Ty};
+use crate::smt::{Config, Context, ReadOpts, SmtResult, Solver, WriteOpts};
+use crate::source_loc::SourceLoc;
+use std::collections::BTreeMap;
+
+mod pointer;
+mod read_evidence;
+mod rejected_store;
+mod resolution;
+mod state;
+mod unsupported;
+
+fn memory(solver: &mut Solver<B64>, initial: BTreeMap<u64, u8>) -> Memory<B64> {
+    let mut memory = Memory::new();
+    memory.set_client_info(Box::new(SequentialMemory::new(&initial, solver)));
+    memory
+}
+
+fn store(
+    memory: &mut Memory<B64>,
+    solver: &mut Solver<B64>,
+    address: Val<B64>,
+    data: Val<B64>,
+    primitive_status: bool,
+) -> Result<(), Box<dyn std::error::Error>> {
+    let result = memory.write(Val::Unit, address, data, solver, None, WriteOpts::default())?;
+    solver.assert_eq(smt_value(&result, SourceLoc::unknown())?, Exp::Bool(primitive_status));
+    Ok(())
+}
+
+fn load(
+    memory: &Memory<B64>,
+    solver: &mut Solver<B64>,
+    address: Val<B64>,
+    bytes: u32,
+) -> Result<Val<B64>, Box<dyn std::error::Error>> {
+    Ok(memory.read(Val::Unit, address, Val::I128(i128::from(bytes)), solver, false, ReadOpts::default())?)
+}
+
+fn equal(
+    solver: &mut Solver<B64>,
+    actual: &Val<B64>,
+    expected: Exp<crate::smt::Sym>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    assert!(matches!(solver.check_sat(SourceLoc::unknown()), SmtResult::Sat));
+    let mutation = Exp::Neq(Box::new(smt_value(actual, SourceLoc::unknown())?), Box::new(expected));
+    assert!(matches!(solver.check_sat_with(&mutation, SourceLoc::unknown()), SmtResult::Unsat));
+    Ok(())
+}
