+// Solver tests compare initialized reads with the declared byte image.
+// Each rejected mutation also needs a satisfiable unchanged query.
+use super::*;
+use isla_lib::bitvector::b64::B64;
+use isla_lib::smt::Sym;
+use std::collections::HashMap;
+
+mod solver;
+
+#[test]
+fn initial_memory_symbolic_addresses_preserve_all_read_widths() -> Result<(), Box<dyn std::error::Error>> {
+    let image = [0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc, 0xde, 0xf0];
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &image, true)?;
+    for bytes in [1, 2, 4, 8] {
+        let script = solver::read_script(&memory, &image, bytes)?;
+        assert_eq!(solver::operate(&script)?, "sat\nunsat\n");
+    }
+    Ok(())
+}
+
+#[test]
+fn initial_memory_legacy_location_retains_priority() -> Result<(), Box<dyn std::error::Error>> {
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &[0x12, 0x34], true)?;
+    let address = Val::Bits(B64::from_u64(0x1000));
+    let initial = HashMap::from([(0x1000, 0x99)]);
+    let expression = super::super::read_initial_symbolic(Sym::from_u32(0), &address, 1, &memory, &initial);
+    let mut script = Vec::new();
+    definition(&mut script, &memory)?;
+    writeln!(script, "(declare-const v0 (_ BitVec 8))\n(assert ")?;
+    expression.write_to(&mut script, false, 0, false)?;
+    writeln!(script, ")\n(check-sat)\n(assert (not (= v0 #x99)))\n(check-sat)")?;
+    assert_eq!(solver::operate(&script)?, "sat\nunsat\n");
+    Ok(())
+}
+
+#[test]
+fn initial_memory_final_value_preserves_loaded_bytes() -> Result<(), Box<dyn std::error::Error>> {
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &[0x12, 0x34], true)?;
+    let value = super::super::initial_write_values::<B64>("#x0000000000001000", 64, &HashMap::new())?;
+    let mut script = Vec::new();
+    definition(&mut script, &memory)?;
+    writeln!(script, "(check-sat)\n(assert (not (= {} #x0000000000003412)))\n(check-sat)", value)?;
+    assert_eq!(solver::operate(&script)?, "sat\nunsat\n");
+    Ok(())
+}
