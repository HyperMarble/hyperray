@@ -0,0 +1,34 @@
+// Array widths and unsupported access modes produce errors.
+// Validation must not assert a restricted address set.
+use crate::bitvector::BV;
+use crate::error::ExecError;
+use crate::ir::Val;
+use crate::primop_util::{length_bits, mixed_bits_to_smt};
+use crate::smt::smtlib::Exp;
+use crate::smt::{Solver, Sym};
+use crate::source_loc::SourceLoc;
+
+pub(super) fn access(exclusive: bool, tagged: bool) -> Result<(), ExecError> {
+    if exclusive {
+        return Err(ExecError::BadRead("Sequential memory does not support exclusive accesses"));
+    }
+    if tagged {
+        return Err(ExecError::BadRead("Sequential memory does not support memory tags"));
+    }
+    Ok(())
+}
+
+pub(super) fn bits<B: BV>(value: &Val<B>, width: u32, solver: &mut Solver<B>) -> Result<Exp<Sym>, ExecError> {
+    if width == 0 || length_bits(value, solver, SourceLoc::unknown())? != width {
+        return Err(ExecError::Type("Sequential memory bitvector width mismatch".to_string(), SourceLoc::unknown()));
+    }
+    mixed_bits_to_smt(value.clone(), solver, SourceLoc::unknown())
+}
+
+pub(super) fn width(bytes: u32) -> Result<u32, ExecError> {
+    let width = bytes.checked_mul(8).ok_or(ExecError::BadRead("Sequential memory byte width overflow"))?;
+    if width == 0 {
+        return Err(ExecError::BadRead("Sequential memory access has zero bytes"));
+    }
+    Ok(width)
+}
