@@ -0,0 +1,50 @@
+// Native solver queries exercise the production initial-read expression.
+// Solver errors and unexpected output are visible test errors.
+use super::*;
+use std::process::{Command, Stdio};
+
+pub(super) fn operate(script: &[u8]) -> Result<String, Box<dyn std::error::Error>> {
+    let mut process =
+        Command::new("z3").arg("-in").stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?;
+    let mut input = process.stdin.take().ok_or("solver stdin is absent")?;
+    input.write_all(script)?;
+    drop(input);
+    let result = process.wait_with_output()?;
+    if !result.status.success() || !result.stderr.is_empty() {
+        return Err(format!("solver error: {:?}: {}", result.status, String::from_utf8_lossy(&result.stderr)).into());
+    }
+    Ok(String::from_utf8(result.stdout)?)
+}
+
+pub(super) fn read_script(
+    memory: &Memory<B64>,
+    image: &[u8],
+    bytes: u32,
+) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
+    let mut script = Vec::new();
+    definition(&mut script, memory)?;
+    writeln!(script, "(declare-const v0 (_ BitVec {}))\n(declare-const v1 (_ BitVec 64))", bytes * 8)?;
+    let expression = super::super::super::read_initial_symbolic(
+        Sym::from_u32(0),
+        &Val::Symbolic(Sym::from_u32(1)),
+        bytes,
+        memory,
+        &HashMap::new(),
+    );
+    write!(script, "(assert ")?;
+    expression.write_to(&mut script, false, 0, false)?;
+    writeln!(
+        script,
+        ")\n(assert (and (bvuge v1 #x0000000000001000) (bvule v1 #x{:016x})))",
+        0x1000 + image.len() - bytes as usize
+    )?;
+    writeln!(script, "(check-sat)\n(assert (or")?;
+    for offset in 0..=image.len() - bytes as usize {
+        let mut expected = [0; 8];
+        expected[..bytes as usize].copy_from_slice(&image[offset..offset + bytes as usize]);
+        let expected = u64::from_le_bytes(expected);
+        writeln!(script, "(and (= v1 #x{:016x}) (not (= v0 (_ bv{} {}))))", 0x1000 + offset, expected, bytes * 8)?;
+    }
+    writeln!(script, "))\n(check-sat)")?;
+    Ok(script)
+}
