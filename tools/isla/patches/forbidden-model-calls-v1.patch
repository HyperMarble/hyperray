+// Solver model values must replace symbolic identifiers in final states.
+// Unknown symbols and non-scalar values must remain errors.
+
+use super::{concrete, symbols};
+use crate::smt_model::Model;
+use isla_lib::bitvector::{b64::B64, BV};
+use isla_lib::ir::Val;
+use isla_lib::smt::Sym;
+
+#[test]
+fn resolves_a_symbolic_bitvector() -> Result<(), String> {
+    let text = "(model (define-fun v7 () (_ BitVec 64) #x0000000000000040))";
+    let mut model = Model::<B64>::parse(&[], text).map_err(|error| error.to_string())?;
+    let result = concrete(Val::Symbolic(Sym::from_u32(7)), &mut model)?;
+    assert_eq!(result, Val::Bits(B64::from_u64(64)));
+    Ok(())
+}
+
+#[test]
+fn resolves_a_get_value_bitvector() -> Result<(), String> {
+    let mut model = Model::<B64>::parse(&[], "((v7 #x0000000000000040))").map_err(|error| error.to_string())?;
+    assert_eq!(concrete(Val::Symbolic(Sym::from_u32(7)), &mut model)?, Val::Bits(B64::from_u64(64)));
+    Ok(())
+}
+
+#[test]
+fn requests_distinct_final_symbols() {
+    let value = Val::<B64>::Symbolic(Sym::from_u32(7));
+    let values = [value.clone(), Val::Bool(true), value];
+    let result = symbols(values.iter());
+    assert_eq!(result.into_iter().collect::<Vec<_>>(), vec!["v7"]);
+}
+
+#[test]
+fn rejects_missing_symbols_and_non_scalars() -> Result<(), String> {
+    let mut model = Model::<B64>::parse(&[], "(model)").map_err(|error| error.to_string())?;
+    assert!(concrete(Val::Symbolic(Sym::from_u32(7)), &mut model).is_err());
+    assert!(concrete(Val::Unit, &mut model).is_err());
+    assert_eq!(concrete(Val::Bool(true), &mut model)?, Val::Bool(true));
+    Ok(())
+}
