@@ -0,0 +1,42 @@
+// Reuse the memory-overlap uniqueness proof for concrete bitvector values.
+// A model sample alone must never replace a symbolic value.
+use crate::bitvector::{b64::B64, BV};
+use crate::error::ExecError;
+use crate::smt::smtlib::Exp;
+use crate::smt::{Model, ModelVal, Solver, Sym};
+use crate::source_loc::SourceLoc;
+
+pub(crate) fn bitvector<B: BV>(solver: &mut Solver<B>, symbol: Sym) -> Result<Option<B>, ExecError> {
+    let location = SourceLoc::unknown();
+    let width =
+        solver.length(symbol).ok_or_else(|| ExecError::Type("Unique value is not a bitvector".into(), location))?;
+    if width > B64::MAX_WIDTH || width > B::MAX_WIDTH {
+        return Ok(None);
+    }
+    if !solver.check_sat(location).is_sat()? {
+        return Err(ExecError::NoModel);
+    }
+    let value = {
+        let mut model = Model::new(solver);
+        match model.get_var(symbol)? {
+            ModelVal::Exp(Exp::Bits64(value)) => value,
+            ModelVal::Arbitrary(_) => return Ok(None),
+            ModelVal::Exp(_) => {
+                return Err(ExecError::Type("Model value is not a concrete bitvector".into(), location))
+            }
+        }
+    };
+    let different = Exp::Neq(Box::new(Exp::Var(symbol)), Box::new(Exp::Bits64(value)));
+    if solver.check_sat_with(&different, location).is_unsat()? {
+        return Ok(Some(B::new(value.lower_u64(), value.len())));
+    }
+    Ok(None)
+}
+
+#[cfg(test)]
+#[path = "unique_value_tests.rs"]
+mod tests;
+
+#[cfg(test)]
+#[path = "unique_overlap_tests.rs"]
+mod overlap_tests;
