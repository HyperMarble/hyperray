@@ -0,0 +1,37 @@
+// Reads across loaded section boundaries preserve each byte and writable state.
+// A partial initial image must not supply invented zero bytes.
+use super::*;
+use crate::error::ExecError;
+use crate::ir::Val;
+use crate::memory::{read_concrete, SmtKind};
+use crate::smt::{ReadOpts, Solver};
+
+impl<B: BV> Memory<B> {
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn read_initialized(
+        &self,
+        read_kind: Val<B>,
+        address: Address,
+        bytes: u32,
+        solver: &mut Solver<B>,
+        tag: bool,
+        opts: ReadOpts,
+    ) -> Result<Option<Val<B>>, ExecError> {
+        let end = address.checked_add(u64::from(bytes)).ok_or(ExecError::BadRead("Loaded read address overflow"))?;
+        let loaded: HashMap<Address, u8> =
+            self.initial_bytes.range(address..end).map(|(address, byte)| (*address, *byte)).collect();
+        if loaded.is_empty() {
+            return Ok(None);
+        }
+        if loaded.len() != bytes as usize {
+            return Err(ExecError::BadRead("Read partially overlaps initialized sections"));
+        }
+        let writable = (address..end).any(|byte| self.access_check(byte, 1, SmtKind::WriteData));
+        let value = if writable {
+            self.read_symbolic(read_kind, Val::Bits(B::from_u64(address)), bytes, solver, tag, opts, "symbolic")?
+        } else {
+            read_concrete(&loaded, read_kind, address, bytes, solver, tag, opts, "concrete")?
+        };
+        Ok(Some(value))
+    }
+}
diff --git a/isla-lib/src/initialized_memory/loaded_write.rs b/isla-lib/src/initialized_memory/loaded_write.rs
new file mode 100644
index 0000000..800eba1
--- /dev/null
+++ b/isla-lib/src/initialized_memory/loaded_write.rs
@@ -0,0 +1,58 @@
+// Stores must not modify initialized read-only bytes behind constant reads.
+// Possible permission faults remain explicit model errors, not constraints.
+use super::*;
+use crate::error::ExecError;
+use crate::ir::Val;
+use crate::memory::SmtKind;
+use crate::smt::smtlib::{bits64, Exp};
+use crate::smt::{SmtResult, Solver};
+use crate::source_loc::SourceLoc;
+
+impl<B: BV> Memory<B> {
+    pub(crate) fn validate_initialized_write(
+        &self,
+        address: &Val<B>,
+        bytes: u32,
+        solver: &mut Solver<B>,
+    ) -> Result<(), ExecError> {
+        if bytes == 0 || self.initial_bytes.is_empty() {
+            return Ok(());
+        }
+        if let Val::Bits(address) = address {
+            return concrete_write(self, address.lower_u64(), bytes);
+        }
+        let Val::Symbolic(address) = address else {
+            return Err(ExecError::BadWrite("Loaded write address is not a bitvector"));
+        };
+        let invalid = self.readonly_write_overlap(Exp::Var(*address), bytes);
+        match solver.check_sat_with(&invalid, SourceLoc::unknown()) {
+            SmtResult::Unsat => Ok(()),
+            SmtResult::Unknown => Err(ExecError::Z3Unknown),
+            SmtResult::Sat => Err(ExecError::BadWrite("Write can overlap initialized read-only memory or overflow")),
+        }
+    }
+
+    fn readonly_write_overlap(&self, address: Exp<crate::smt::Sym>, bytes: u32) -> Exp<crate::smt::Sym> {
+        let mut invalid = Exp::Bvugt(Box::new(address.clone()), Box::new(bits64(u64::MAX - u64::from(bytes), 64)));
+        let readonly = self.initial_bytes.keys().filter(|byte| !self.access_check(**byte, 1, SmtKind::WriteData));
+        for byte in readonly {
+            let first = byte.saturating_sub(u64::from(bytes) - 1);
+            let overlap = Exp::And(
+                Box::new(Exp::Bvuge(Box::new(address.clone()), Box::new(bits64(first, 64)))),
+                Box::new(Exp::Bvule(Box::new(address.clone()), Box::new(bits64(*byte, 64)))),
+            );
+            invalid = Exp::Or(Box::new(invalid), Box::new(overlap));
+        }
+        invalid
+    }
+}
+
+fn concrete_write<B: BV>(memory: &Memory<B>, start: Address, bytes: u32) -> Result<(), ExecError> {
+    let end = start.checked_add(u64::from(bytes)).ok_or(ExecError::BadWrite("Loaded write address overflow"))?;
+    let invalid =
+        memory.initial_bytes.range(start..end).any(|(byte, _)| !memory.access_check(*byte, 1, SmtKind::WriteData));
+    if invalid {
+        return Err(ExecError::BadWrite("Write overlaps initialized read-only memory"));
+    }
+    Ok(())
+}
