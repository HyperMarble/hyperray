+// Actual memory errors preserve the prior sequential state.
+// The primitive Boolean must not replace an error result.
+use super::*;
+
+#[test]
+fn sequential_memory_rejected_write_preserves_initial_bytes() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::from([(0x1000, 0x12), (0x1001, 0x34)]));
+    let address = Val::Bits(B64::from_u64(0x1000));
+    let initial = load(&memory, &mut solver, address.clone(), 2)?;
+    equal(&mut solver, &initial, bits64(0x3412, 16))?;
+    let invalid = memory.write(
+        Val::Unit,
+        Val::Bits(B64::new(0x1000, 16)),
+        Val::Bits(B64::new(0x7788, 16)),
+        &mut solver,
+        None,
+        WriteOpts::default(),
+    );
+    assert!(invalid.is_err());
+    let result = load(&memory, &mut solver, address, 2)?;
+    equal(&mut solver, &result, bits64(0x3412, 16))
+}
