@@ -0,0 +1,28 @@
+// Ordinary RISC-V RAM stores update the byte array after validation.
+// The primitive Boolean is not an ordinary-store fault result.
+use super::validate;
+use crate::bitvector::BV;
+use crate::error::ExecError;
+use crate::ir::Val;
+use crate::smt::smtlib::{bits64, Exp};
+use crate::smt::{Solver, Sym};
+use crate::source_loc::SourceLoc;
+
+pub(super) fn update<B: BV>(
+    memory: Sym,
+    solver: &mut Solver<B>,
+    address: &Val<B>,
+    data: &Val<B>,
+    bytes: u32,
+) -> Result<Sym, ExecError> {
+    let width = validate::width(bytes)?;
+    let address = validate::bits(address, 64, solver)?;
+    let data = validate::bits(data, width, solver)?;
+    let mut contents = Exp::Var(memory);
+    for offset in 0..bytes {
+        let location = Exp::Bvadd(Box::new(address.clone()), Box::new(bits64(u64::from(offset), 64)));
+        let byte = Exp::Extract(offset * 8 + 7, offset * 8, Box::new(data.clone()));
+        contents = Exp::Store(Box::new(contents), Box::new(location), Box::new(byte));
+    }
+    Ok(solver.define_const(contents, SourceLoc::unknown()))
+}
