@@ -0,0 +1,41 @@
+// Sequential execution requires one closed thread and ordinary loaded memory.
+// Unsupported effects remain errors instead of hidden assumptions.
+use isla_lib::bitvector::BV;
+use isla_lib::memory::Memory;
+use isla_lib::sequential_memory::SequentialMemory;
+use isla_lib::smt::Solver;
+
+use crate::litmus::{Litmus, Thread};
+use crate::memory_profile::MemoryProfile;
+use crate::run_litmus::LitmusRunOpts;
+
+pub(crate) fn validate<B: BV>(litmus: &Litmus<B>, opts: &LitmusRunOpts) -> Result<(), String> {
+    if litmus.memory_profile == MemoryProfile::Axiomatic {
+        return Ok(());
+    }
+    if litmus.arch != "RISCV" || litmus.threads.len() != 1 {
+        return Err("Sequential memory requires one RV64 program thread".to_string());
+    }
+    if opts.armv8_page_tables || !litmus.page_table_setup.is_empty() {
+        return Err("Sequential memory does not support page-table effects".to_string());
+    }
+    if opts.merge_translations.is_some() || opts.remove_uninteresting_translates.is_some() {
+        return Err("Sequential memory does not support translation-event rewrites".to_string());
+    }
+    if !litmus.self_modify_regions.is_empty() || !litmus.locations.is_empty() {
+        return Err("Sequential memory requires section-based initial memory".to_string());
+    }
+    match &litmus.threads[0] {
+        Thread::Assembled(thread) if thread.code.is_empty() && thread.interrupts.is_empty() => Ok(()),
+        Thread::Assembled(_) | Thread::IR(_) => {
+            Err("Sequential memory requires an executable entry without interrupts".to_string())
+        }
+    }
+}
+
+pub(crate) fn install<B: BV>(profile: MemoryProfile, memory: &mut Memory<B>, solver: &mut Solver<B>) {
+    if profile == MemoryProfile::Sequential {
+        let callback = SequentialMemory::new(memory.initialized_bytes(), solver);
+        memory.set_client_info(Box::new(callback));
+    }
+}
