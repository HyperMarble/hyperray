+// Adjacent loaded sections share byte-level read behavior.
+// A missing initial byte must cause an error instead of a constant.
+use super::*;
+use crate::bitvector::b64::B64;
+use crate::ir::Val;
+use crate::smt::{Config, Context, ReadOpts, Solver};
+
+#[test]
+fn read_across_readonly_sections_retains_each_byte() -> Result<(), String> {
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &[0x12], false)?;
+    memory.initialize_section(0x1001, &[0x34], false)?;
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
