+// Permission tests reject concrete and possible symbolic writes to read-only bytes.
+// Rejection must preserve the model state rather than remove an execution.
+use super::*;
+use crate::bitvector::b64::B64;
+use crate::ir::Val;
+use crate::smt::smtlib::{bits64, Exp, Ty};
+use crate::smt::{Config, Context, Event, SmtResult, Solver, WriteOpts};
+use crate::source_loc::SourceLoc;
+
+#[test]
+fn concrete_write_cannot_change_readonly_initial_bytes() -> Result<(), String> {
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &[0x12, 0x34], false)?;
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let result = memory.write(
+        Val::Unit,
+        Val::Bits(B64::from_u64(0x0fff)),
+        Val::Bits(B64::new(0x7788, 16)),
+        &mut solver,
+        None,
+        WriteOpts::default(),
+    );
+    assert!(matches!(result, Err(crate::error::ExecError::BadWrite("Write overlaps initialized read-only memory"))));
+    assert!(!solver.trace().to_vec().iter().any(|event| matches!(event, Event::WriteMem { .. })));
+    assert!(matches!(memory.read_initial(0x1000, 2), Ok(Val::Bits(bits)) if bits.lower_u64() == 0x3412));
+    Ok(())
+}
+
+#[test]
+fn possible_symbolic_readonly_write_is_an_error() -> Result<(), String> {
+    let mut memory = Memory::<B64>::new();
+    memory.initialize_section(0x1000, &[0x12], false)?;
+    memory.initialize_section(0x1001, &[0x34], true)?;
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let address = solver.declare_const(Ty::BitVec(64), SourceLoc::unknown());
+    solver.assert(Exp::Or(
+        Box::new(Exp::Eq(Box::new(Exp::Var(address)), Box::new(bits64(0x1000, 64)))),
+        Box::new(Exp::Eq(Box::new(Exp::Var(address)), Box::new(bits64(0x1001, 64)))),
+    ));
+    let rejected = memory.write(
+        Val::Unit,
+        Val::Symbolic(address),
+        Val::Bits(B64::new(0x77, 8)),
+        &mut solver,
+        None,
+        WriteOpts::default(),
+    );
+    assert!(rejected.is_err());
+    assert!(matches!(solver.check_sat(SourceLoc::unknown()), SmtResult::Sat));
+    solver.assert_eq(Exp::Var(address), bits64(0x1001, 64));
+    let accepted = memory.write(
+        Val::Unit,
+        Val::Symbolic(address),
+        Val::Bits(B64::new(0x77, 8)),
+        &mut solver,
+        None,
+        WriteOpts::default(),
+    );
+    assert!(accepted.is_ok());
+    Ok(())
+}
