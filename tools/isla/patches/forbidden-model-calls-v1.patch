+++ b/isla-axiomatic/src/initial_state.rs
@@ -0,0 +1,50 @@
+// Initial state reuses the model value parser and declared register types.
+// Unknown names and conflicting assignments must not disappear from execution.
+use isla_lib::bitvector::BV;
+use isla_lib::ir::{Name, SharedState, Val};
+use isla_lib::ir_lexer::new_ir_lexer;
+use isla_lib::value_parser::ValParser;
+use isla_lib::zencode;
+use std::collections::{BTreeMap, HashMap};
+use toml::Value;
+
+pub(crate) fn parse(input: &Value) -> Result<BTreeMap<String, String>, String> {
+    let Some(table) = input.get("initial_state") else {
+        return Ok(BTreeMap::new());
+    };
+    let table = table.as_table().ok_or("Initial state must be a table")?;
+    table
+        .iter()
+        .map(|(name, value)| {
+            let value = value.as_str().ok_or("Initial state values must be strings")?;
+            Ok((name.clone(), value.to_string()))
+        })
+        .collect()
+}
+
+pub(crate) fn values<B: BV>(
+    input: &BTreeMap<String, String>,
+    state: &SharedState<B>,
+) -> Result<HashMap<Name, Val<B>>, String> {
+    let mut values = HashMap::new();
+    for (name, source) in input {
+        let register = state
+            .symtab
+            .get(&zencode::encode(name))
+            .ok_or_else(|| format!("Initial state names unknown register {}", name))?;
+        let ty =
+            state.registers.get(&register).ok_or_else(|| format!("Initial state name is not a register: {}", name))?;
+        let value = ValParser::new()
+            .parse(&state.symtab, &state.type_info, new_ir_lexer(source))
+            .map_err(|error| format!("Invalid initial state for {}: {}", name, error))?;
+        if !crate::initial_state_type::matches(&value, ty, &state.type_info) {
+            return Err(format!("Initial state for {} does not match its declared type", name));
+        }
+        values.insert(register, value);
+    }
+    Ok(values)
+}
+
+#[cfg(test)]
+#[path = "initial_state_tests.rs"]
+mod tests;
