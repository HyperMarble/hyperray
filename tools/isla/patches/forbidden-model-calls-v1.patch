@@ -0,0 +1,32 @@
+// Sequential RISC-V RAM reuses persistent SMT byte arrays from isla-testgen.
+// It must not interpret the primitive Boolean as an ordinary-store fault.
+use crate::bitvector::BV;
+use crate::smt::smtlib::{bits64, Exp, Ty};
+use crate::smt::{Solver, Sym};
+use crate::source_loc::SourceLoc;
+use std::collections::BTreeMap;
+
+mod callbacks;
+mod read;
+#[cfg(test)]
+mod tests;
+mod validate;
+mod write;
+
+#[derive(Debug, Clone)]
+pub struct SequentialMemory {
+    memory: Sym,
+}
+
+impl SequentialMemory {
+    pub fn new<B: BV>(initialized: &BTreeMap<u64, u8>, solver: &mut Solver<B>) -> Self {
+        let array =
+            solver.declare_const(Ty::Array(Box::new(Ty::BitVec(64)), Box::new(Ty::BitVec(8))), SourceLoc::unknown());
+        let mut contents = Exp::Var(array);
+        for (address, byte) in initialized {
+            contents =
+                Exp::Store(Box::new(contents), Box::new(bits64(*address, 64)), Box::new(bits64(u64::from(*byte), 8)));
+        }
+        Self { memory: solver.define_const(contents, SourceLoc::unknown()) }
+    }
+}
diff --git a/isla-lib/src/sequential_memory/read.rs b/isla-lib/src/sequential_memory/read.rs
new file mode 100644
index 0000000..1b65bbb
--- /dev/null
+++ b/isla-lib/src/sequential_memory/read.rs
@@ -0,0 +1,28 @@
+// Reads concatenate array bytes in little-endian order.
+// Only value equality enters the solver, never address assumptions.
+use super::validate;
+use crate::bitvector::BV;
+use crate::error::ExecError;
+use crate::ir::Val;
+use crate::smt::smtlib::{bits64, Exp};
+use crate::smt::{Solver, Sym};
+
+pub(super) fn constrain<B: BV>(
+    memory: Sym,
+    solver: &mut Solver<B>,
+    value: &Val<B>,
+    address: &Val<B>,
+    bytes: u32,
+) -> Result<(), ExecError> {
+    let width = validate::width(bytes)?;
+    let address = validate::bits(address, 64, solver)?;
+    let value = validate::bits(value, width, solver)?;
+    let mut read = Exp::Select(Box::new(Exp::Var(memory)), Box::new(address.clone()));
+    for offset in 1..bytes {
+        let location = Exp::Bvadd(Box::new(address.clone()), Box::new(bits64(u64::from(offset), 64)));
+        let byte = Exp::Select(Box::new(Exp::Var(memory)), Box::new(location));
+        read = Exp::Concat(Box::new(byte), Box::new(read));
+    }
+    solver.assert_eq(value, read);
+    Ok(())
+}
