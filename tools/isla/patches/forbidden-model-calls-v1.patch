+// Unsupported operations return errors through the public memory API.
+// Error paths must not remove the current execution with false assumptions.
+use super::*;
+
+#[test]
+fn sequential_memory_rejects_exclusive_tag_and_symbolic_fetch() -> Result<(), Box<dyn std::error::Error>> {
+    let context = Context::new(Config::new());
+    let mut solver = Solver::new(&context);
+    let mut memory = memory(&mut solver, BTreeMap::new());
+    memory.add_symbolic_code_region(0x1000..0x2000);
+    let address = Val::Bits(B64::from_u64(0x1000));
+    for (options, tag) in [(ReadOpts::exclusive(), false), (ReadOpts::default(), true), (ReadOpts::ifetch(), false)] {
+        assert!(memory.read(Val::Unit, address.clone(), Val::I128(1), &mut solver, tag, options).is_err());
+    }
+    assert!(memory
+        .write(Val::Unit, address.clone(), Val::Bits(B64::new(1, 8)), &mut solver, None, WriteOpts::exclusive())
