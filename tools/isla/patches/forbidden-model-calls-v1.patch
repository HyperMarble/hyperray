@@ -0,0 +1,23 @@
+// Memory profiles declare execution contracts before trace exploration.
+// Unknown profiles must never select different semantics silently.
+use toml::Value;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MemoryProfile {
+    Axiomatic,
+    Sequential,
+}
+
+impl MemoryProfile {
+    pub fn parse(source: &Value) -> Result<Self, String> {
+        match source.get("memory_profile") {
+            None => Ok(Self::Axiomatic),
+            Some(Value::String(name)) if name == "sequential" => Ok(Self::Sequential),
+            Some(value) => Err(format!("Unsupported memory profile: {}", value)),
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "memory_profile_tests.rs"]
+mod tests;
