+// Executable input metadata must retain addresses and writable declarations.
+// Malformed values must not silently select a legacy default.
+use super::{parse_executable_entry, parse_extra};
+use toml::Value;
+
+#[test]
+fn executable_entry_is_explicit_or_absent() -> Result<(), String> {
+    let explicit: Value = toml::from_str("entry = '0x80100024'").map_err(|error| error.to_string())?;
+    assert_eq!(parse_executable_entry(&explicit)?, Some(0x80100024));
+    let absent: Value = toml::from_str("").map_err(|error| error.to_string())?;
+    assert_eq!(parse_executable_entry(&absent)?, None);
+    for source in ["entry = 64", "entry = '0xwrong'", "entry = ''"] {
+        let malformed: Value = toml::from_str(source).map_err(|error| error.to_string())?;
+        assert!(parse_executable_entry(&malformed).is_err());
+    }
+    Ok(())
+}
+
+#[test]
+fn writable_sections_require_a_boolean() -> Result<(), String> {
+    let name = "loaded".to_string();
+    for writable in ["true", "false"] {
+        let source = format!("address = '0x80200000'\ncode = '.byte 11'\nwritable = {}", writable);
+        let value: Value = toml::from_str(&source).map_err(|error| error.to_string())?;
+        let section = parse_extra((&name, &value))?;
+        assert_eq!(section.writable, writable == "true");
+        assert_eq!(section.address, 0x80200000);
+    }
+    let source = "address = '0x80200000'\ncode = '.byte 11'\nwritable = 'true'";
+    let value: Value = toml::from_str(source).map_err(|error| error.to_string())?;
+    assert!(parse_extra((&name, &value)).is_err());
+    Ok(())
+}
