diff --git a/isla-axiomatic/src/final_value.rs b/isla-axiomatic/src/final_value.rs
new file mode 100644
--- /dev/null
+++ b/isla-axiomatic/src/final_value.rs
@@ -0,0 +1,37 @@
+// Final register values come from the solver model, never symbolic identifiers.
+// Unsupported model values remain explicit output errors.
+
+use crate::sexp::SexpVal;
+use crate::smt_model::Model;
+use isla_lib::bitvector::BV;
+use isla_lib::ir::Val;
+use std::collections::BTreeSet;
+
+#[cfg(test)]
+#[path = "final_value_tests.rs"]
+mod tests;
+
+pub(crate) fn symbols<'a, B: BV>(values: impl Iterator<Item = &'a Val<B>>) -> BTreeSet<String> {
+    let mut symbols = BTreeSet::new();
+    for value in values {
+        if let Val::Symbolic(symbol) = value {
+            symbols.insert(format!("v{}", symbol));
+        }
+    }
+    symbols
+}
+
+pub(crate) fn concrete<B: BV>(value: Val<B>, model: &mut Model<'_, '_, B>) -> Result<Val<B>, String> {
+    let symbol = match value {
+        Val::Symbolic(symbol) => symbol,
+        Val::Bits(_) | Val::Bool(_) | Val::I64(_) | Val::I128(_) => return Ok(value),
+        _ => return Err("final register is not a scalar model value".to_string()),
+    };
+    let result = model.interpret(&format!("v{}", symbol), &[]).map_err(|error| error.to_string())?;
+    match result {
+        SexpVal::Bits(bits) => Ok(Val::Bits(bits)),
+        SexpVal::Bool(value) => Ok(Val::Bool(value)),
+        SexpVal::I128(value) => Ok(Val::I128(value)),
+        SexpVal::Event(_) | SexpVal::Relation(_) => Err("final register model value is not a scalar".to_string()),
+    }
+}
diff --git a/isla-axiomatic/src/final_value_tests.rs b/isla-axiomatic/src/final_value_tests.rs
new file mode 100644
--- /dev/null
+++ b/isla-axiomatic/src/final_value_tests.rs
@@ -0,0 +1,41 @@
+// Solver model values must replace symbolic identifiers in final states.
+// Unknown symbols and non-scalar values must remain errors.
+
+use super::{concrete, symbols};
+use crate::smt_model::Model;
+use isla_lib::bitvector::{b64::B64, BV};
+use isla_lib::ir::Val;
+use isla_lib::smt::Sym;
+
+#[test]
+fn resolves_a_symbolic_bitvector() -> Result<(), String> {
+    let text = "(model (define-fun v7 () (_ BitVec 64) #x0000000000000040))";
+    let mut model = Model::<B64>::parse(&[], text).map_err(|error| error.to_string())?;
+    let result = concrete(Val::Symbolic(Sym::from_u32(7)), &mut model)?;
+    assert_eq!(result, Val::Bits(B64::from_u64(64)));
+    Ok(())
+}
+
+#[test]
+fn resolves_a_get_value_bitvector() -> Result<(), String> {
+    let mut model = Model::<B64>::parse(&[], "((v7 #x0000000000000040))").map_err(|error| error.to_string())?;
+    assert_eq!(concrete(Val::Symbolic(Sym::from_u32(7)), &mut model)?, Val::Bits(B64::from_u64(64)));
+    Ok(())
+}
+
+#[test]
+fn requests_distinct_final_symbols() {
+    let value = Val::<B64>::Symbolic(Sym::from_u32(7));
+    let values = [value.clone(), Val::Bool(true), value];
+    let result = symbols(values.iter());
+    assert_eq!(result.into_iter().collect::<Vec<_>>(), vec!["v7"]);
+}
+
+#[test]
+fn rejects_missing_symbols_and_non_scalars() -> Result<(), String> {
+    let mut model = Model::<B64>::parse(&[], "(model)").map_err(|error| error.to_string())?;
+    assert!(concrete(Val::Symbolic(Sym::from_u32(7)), &mut model).is_err());
+    assert!(concrete(Val::Unit, &mut model).is_err());
+    assert_eq!(concrete(Val::Bool(true), &mut model)?, Val::Bool(true));
+    Ok(())
+}
