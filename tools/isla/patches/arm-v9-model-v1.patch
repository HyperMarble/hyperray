+/// The reset locations that carry the S1 table base.
+fn table_base_locations<'a, B: BV>(state: &SharedState<'a, B>, shape: ModelShape) -> Result<Vec<Loc<Name>>, String> {
+    let register = |name: &'static str| {
+        state.symtab.get(&crate::zencode::encode(name)).ok_or_else(|| format!("ARM reset register missing: {name}"))
+    };
+    match shape {
+        ModelShape::V85 => Ok(vec![Loc::Id(register("TTBR0_EL1")?)]),
+        ModelShape::V9 => {
+            let bits = state.symtab.get("zbits").ok_or("ARM reset: model lacks a `bits` field")?;
+            Ok(["_TTBR0_EL1", "TTBR0_NS", "TTBR0_S"]
+                .iter()
+                .map(|name| register(name).map(|id| Loc::Field(Box::new(Loc::Id(id)), bits)))
+                .collect::<Result<Vec<_>, _>>()?)
+        }
+    }
+}
