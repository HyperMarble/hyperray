// Connect compiler-validated functions without deriving the requirement.
// This binding must not compute a replacement subject result.
extern crate requirement;
extern crate subject;

#[no_mangle]
pub extern "C" fn hyperray_subject(input: u64) -> u64 {{
    subject::{subject}(input)
}}

#[no_mangle]
pub extern "C" fn hyperray_requirement(input: u64, output: u64) -> i32 {{
    i32::from(requirement::{requirement}(input, output))
}}
