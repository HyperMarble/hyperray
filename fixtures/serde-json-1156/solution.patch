+use super::{Deserializer, Read, Result, StreamDeserializer};
+use core::result;
+use serde::de::{self, DeserializeSeed};
+
+/// A JSON stream deserializer that reuses one value across successive inputs.
+///
+/// Unlike [`StreamDeserializer`], this type owns the value being deserialized.
+/// Its [`next`](Self::next) method returns a mutable reference tied to the
+/// borrow of the stream, so the value can be processed before advancing again.
+///
+/// This type does not implement [`Iterator`] because an iterator cannot return
+/// references borrowed from itself. Use [`next`](Self::next) directly.
+pub struct InPlaceStreamDeserializer<'de, R, T> {
+    stream: StreamDeserializer<'de, R, T>,
+    value: T,
+}
+
+struct InPlaceSeed<'a, T>(&'a mut T);
+
+impl<'a, 'de, T> DeserializeSeed<'de> for InPlaceSeed<'a, T>
+where
+    T: de::Deserialize<'de>,
+{
+    type Value = ();
+
+    fn deserialize<D>(self, deserializer: D) -> result::Result<Self::Value, D::Error>
+    where
+        D: de::Deserializer<'de>,
+    {
+        T::deserialize_in_place(deserializer, self.0)
+    }
+}
+
+impl<'de, R> Deserializer<R>
+where
+    R: Read<'de>,
+{
+    /// Turn a JSON deserializer into a stream that reuses one value of type `T`.
+    ///
+    /// Each successful call to [`InPlaceStreamDeserializer::next`] updates
+    /// `value` through [`Deserialize::deserialize_in_place`] and returns a
+    /// mutable reference to it.
+    ///
+    /// ```
+    /// use serde::Deserialize;
+    /// use serde_json::Deserializer;
+    ///
+    /// #[derive(Deserialize)]
+    /// struct Record {
+    ///     name: String,
+    /// }
+    ///
+    /// let data = r#"{"name":"first"} {"name":"second"}"#;
+    /// let mut stream = Deserializer::from_str(data).into_iter_in_place(Record {
+    ///     name: String::new(),
+    /// });
+    ///
+    /// assert_eq!(stream.next().unwrap().unwrap().name, "first");
+    /// assert_eq!(stream.next().unwrap().unwrap().name, "second");
+    /// assert!(stream.next().is_none());
+    /// ```
+    ///
+    /// [`Deserialize::deserialize_in_place`]: serde::Deserialize::deserialize_in_place
+    pub fn into_iter_in_place<T>(self, value: T) -> InPlaceStreamDeserializer<'de, R, T>
+    where
+        T: de::Deserialize<'de>,
+    {
+        self.into_iter().with_value(value)
+    }
+}
+
+impl<'de, R, T> StreamDeserializer<'de, R, T>
+where
+    R: Read<'de>,
+    T: de::Deserialize<'de>,
+{
+    /// Converts this stream into one that reuses `value` for every input.
+    ///
+    /// The new stream begins at the current byte offset and preserves any
+    /// failure state already recorded by this stream.
+    pub fn with_value(self, value: T) -> InPlaceStreamDeserializer<'de, R, T> {
+        InPlaceStreamDeserializer {
+            stream: self,
+            value,
+        }
+    }
+
+    /// Deserializes the next JSON value into an existing `T`.
+    ///
+    /// This calls [`Deserialize::deserialize_in_place`], allowing implementations
+    /// to reuse allocations owned by `place`. On success, the returned reference
+    /// is the same reference that was passed in. If the stream is at EOF, this
+    /// returns `None` without modifying `place`.
+    ///
+    /// If deserialization returns an error, `place` may have been partially
+    /// overwritten, as specified by `Deserialize::deserialize_in_place`.
+    ///
+    /// [`Deserialize::deserialize_in_place`]: serde::Deserialize::deserialize_in_place
+    pub fn next_in_place<'a>(&mut self, place: &'a mut T) -> Option<Result<&'a mut T>> {
+        match self.next_seed(InPlaceSeed(place)) {
+            Some(Ok(())) => Some(Ok(place)),
+            Some(Err(error)) => Some(Err(error)),
+            None => None,
+        }
+    }
+}
+
+impl<'de, R, T> InPlaceStreamDeserializer<'de, R, T>
+where
+    R: Read<'de>,
+    T: de::Deserialize<'de>,
+{
+    /// Creates an in-place stream deserializer from a JSON input source and an
+    /// initial value.
+    ///
+    /// Usually it is more convenient to call
+    /// [`Deserializer::into_iter_in_place`]. This constructor is useful when a
+    /// custom implementation of [`Read`] is already available.
+    pub fn new(read: R, value: T) -> Self {
+        StreamDeserializer::new(read).with_value(value)
+    }
+
+    /// Returns the number of bytes consumed by successful deserializations.
+    ///
+    /// This has the same offset semantics as
+    /// [`StreamDeserializer::byte_offset`]. In particular, when the stream
+    /// reaches clean EOF, the offset includes trailing whitespace.
+    pub fn byte_offset(&self) -> usize {
+        self.stream.byte_offset()
+    }
+
+    /// Returns a shared reference to the reusable value.
+    ///
+    /// Before the first successful call to [`next`](Self::next), this is the
+    /// initial value passed to the constructor. Afterward it contains the most
+    /// recently deserialized value.
+    pub fn get_ref(&self) -> &T {
+        &self.value
+    }
+
+    /// Returns a mutable reference to the reusable value.
+    ///
+    /// Changes made through this reference become the starting state for the
+    /// next in-place deserialization.
+    pub fn get_mut(&mut self) -> &mut T {
+        &mut self.value
+    }
+
+    /// Deserializes the next JSON value into the stored value.
+    ///
+    /// On success this returns a mutable reference to the stored value. At
+    /// clean EOF it returns `None` without modifying the value. If
+    /// deserialization fails, the value may have been partially overwritten,
+    /// as specified by [`Deserialize::deserialize_in_place`].
+    ///
+    /// The stream's delimiter validation, failure handling, and byte offsets
+    /// are identical to [`StreamDeserializer::next`].
+    ///
+    /// [`Deserialize::deserialize_in_place`]: serde::Deserialize::deserialize_in_place
+    pub fn next(&mut self) -> Option<Result<&mut T>> {
+        self.stream.next_in_place(&mut self.value)
+    }
+
+    /// Consumes this wrapper and returns the underlying stream and stored value.
+    ///
+    /// The returned stream retains its current byte offset and failure state,
+    /// and can be used for ordinary or in-place deserialization.
+    pub fn into_parts(self) -> (StreamDeserializer<'de, R, T>, T) {
+        (self.stream, self.value)
+    }
+}
